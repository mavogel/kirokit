+func (f fixture) render(t *testing.T, ids map[string]string) (string, Result, error) {
+	t.Helper()
+	out := filepath.Join(t.TempDir(), "bundle")
+	res, err := RenderTeam(f.teamsRoot, "t", f.globalRoot, f.versions, out, Options{IDs: ids})
+	return out, res, err
