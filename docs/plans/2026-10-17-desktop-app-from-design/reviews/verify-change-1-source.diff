+	}
+	if err := os.WriteFile(filepath.Join(home, ".kirokit-installed", "old-team.json"), []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := runRoot(t, "install", "data-team")
