+          # Fine-grained PAT with contents:write on mavogel/homebrew-tap.
+          HOMEBREW_TAP_GITHUB_TOKEN: ${{ secrets.HOMEBREW_TAP_GITHUB_TOKEN }}
+          TAG: ${{ needs.release.outputs.tag }}
+        run: bash scripts/desktop-release.sh --version "$TAG" --app desktop/build/bin/kirokit.app --out "$RUNNER_TEMP/desktop-release" --publish
