@@ -0,0 +1,150 @@
+:root {
+  color-scheme: light;
+  --bg: #f4f2fa;
+  --window: #ffffff;
+  --sidebar: #f1eff9;
+  --surface: #ffffff;
+  --surface-2: #f8f7fc;
+  --text: #1d1730;
+  --muted: #574f6e;
+  --border: #e1ddef;
+  --border-strong: #c9c2e0;
+  --control-border: #857c9f;
+  --accent: #6d28d9;
+  --accent-text: #ffffff;
+  --accent-soft: #ede9fe;
+  --accent-ink: #5b21b6;
+  --ok: #166534;
+  --ok-soft: #dcfce7;
+  --warn: #854d0e;
+  --warn-soft: #fef3c7;
+  --focus: #6d28d9;
+  --term-bg: #15111f;
+  --term-text: #e6e1f5;
+  --term-muted: #a59dbd;
+  --term-prompt: #b9a4fb;
+  --radius: 8px;
+  --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    color-scheme: dark;
+    --bg: #0d0b13; --window: #17131f; --sidebar: #120f1a; --surface: #1d1828; --surface-2: #221c30;
+    --text: #ece9f6; --muted: #aaa3c2; --border: #2e2843; --border-strong: #463e60; --control-border: #776e98;
+    --term-bg: #0b0911;
+    --accent: #a78bfa; --accent-text: #14101f; --accent-soft: #2b2247; --accent-ink: #c4b5fd;
+    --ok: #4ade80; --ok-soft: #12301f; --warn: #fbbf24; --warn-soft: #33280c; --focus: #c4b5fd;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { height: 100%; }
+body { margin: 0; background: var(--window); color: var(--text); font: 14px/1.5 var(--font); }
+button, input { font: inherit; color: inherit; }
+:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+[hidden] { display: none !important; }
+.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+
+.app { display: grid; grid-template-columns: auto 1fr; height: 100vh; min-height: 0; }
+
+/* Sidebar */
+.sidebar { width: 232px; display: flex; flex-direction: column; gap: 4px; padding: 14px 10px 12px;
+  background: var(--sidebar); border-right: 1px solid var(--border); transition: width .16s ease; }
+.brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px 14px; font-weight: 650; font-size: 15px; }
+.brand .mark { flex: none; width: 28px; height: 28px; }
+.nav { display: flex; flex-direction: column; gap: 2px; margin: 0; padding: 0; list-style: none; }
+.nav button { width: 100%; display: flex; align-items: center; gap: 12px; height: 36px; padding: 0 10px;
+  border: 0; border-radius: 6px; background: transparent; cursor: pointer; text-align: left; color: var(--muted); }
+.nav button:hover { background: var(--accent-soft); color: var(--text); }
+.nav button[aria-current="page"] { background: var(--accent-soft); color: var(--accent-ink); font-weight: 600; }
+.nav svg, .collapse svg { flex: none; width: 18px; height: 18px; }
+.nav .count { margin-left: auto; font-size: 12px; color: var(--muted); }
+.nav .count:empty { display: none; }
+.spacer { flex: 1; }
+.collapse { display: flex; align-items: center; gap: 12px; height: 36px; padding: 0 10px; border: 0; border-radius: 6px;
+  background: transparent; color: var(--muted); cursor: pointer; text-align: left; }
+.collapse:hover { background: var(--accent-soft); color: var(--text); }
+.collapse kbd { margin-left: auto; font: 12px var(--mono); color: var(--muted); }
+.rail .sidebar { width: 60px; }
+.rail .count, .rail .brand-name, .rail .collapse kbd { display: none; }
+.rail .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.rail .nav button, .rail .collapse { justify-content: center; padding: 0; }
+.rail .collapse svg { transform: rotate(180deg); }
+.rail .brand { justify-content: center; padding-inline: 0; }
+
+/* Main */
+.work { display: grid; grid-template-rows: 1fr auto; min-width: 0; min-height: 0; }
+main { overflow: auto; padding: 24px 28px; min-height: 0; }
+.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
+h1 { margin: 0; font-size: 20px; line-height: 1.3; font-weight: 650; }
+.lede { margin: 2px 0 0; color: var(--muted); max-width: 70ch; }
+h2 { margin: 22px 0 10px; font-size: 14px; font-weight: 650; }
+.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
+.card { display: flex; flex-direction: column; gap: 12px; padding: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
+.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
+.card h3 { margin: 0; font: 600 15px/1.3 var(--mono); }
+.facts { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: 13px; }
+.facts b { color: var(--text); font-weight: 600; }
+.actions { display: flex; gap: 8px; margin-top: auto; }
+.btn { height: 32px; padding: 0 14px; border-radius: 6px; border: 1px solid var(--border-strong); background: var(--surface); cursor: pointer; font-weight: 550; }
+.btn:hover { background: var(--surface-2); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
+.btn.primary:hover { filter: brightness(1.08); }
+.btn:disabled { opacity: .55; cursor: not-allowed; filter: none; }
+.badge { display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0 8px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
+.badge.ok { background: var(--ok-soft); color: var(--ok); }
+.badge.off { background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); }
+.badge.warn { background: var(--warn-soft); color: var(--warn); }
+.chip { display: inline-block; padding: 1px 7px; margin: 0 4px 4px 0; border-radius: 4px; background: var(--surface-2); border: 1px solid var(--border); font: 12px/1.6 var(--mono); }
+table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
+th, td { padding: 10px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
+th { font-size: 12px; font-weight: 600; color: var(--muted); background: var(--surface-2); }
+tr:last-child td { border-bottom: 0; }
+td.mono, .mono { font-family: var(--mono); font-size: 13px; }
+td.num { font-variant-numeric: tabular-nums; }
+.desc { color: var(--muted); max-width: 46ch; }
+.note { color: var(--muted); font-size: 12px; margin: 8px 0 0; }
+.field { display: grid; gap: 6px; max-width: 520px; margin-bottom: 16px; }
+.field label { font-weight: 600; }
+.field input { height: 36px; padding: 0 10px; border: 1px solid var(--control-border); border-radius: 6px; background: var(--surface); font-family: var(--mono); font-size: 13px; }
+.field input[aria-invalid="true"] { border-color: var(--warn); }
+.field .hint { color: var(--muted); font-size: 13px; }
+.field .error { color: var(--warn); font-size: 13px; }
+.actions .error, .row-actions .error { color: var(--warn); font-size: 13px; align-self: center; }
+.actions { align-items: center; flex-wrap: wrap; }
+.row-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.welcome { max-width: 520px; }
+.app.setup { grid-template-columns: 1fr; }
+.app.setup .sidebar { display: none; }
+
+/* Dialogs */
+dialog { width: min(480px, calc(100vw - 32px)); padding: 20px; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--window); color: var(--text); }
+dialog::backdrop { background: rgb(13 11 19 / .5); }
+dialog h2 { margin: 0 0 8px; font-size: 16px; }
+.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
+.checks { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
+.checks li { display: grid; grid-template-columns: auto auto 1fr; align-items: baseline; gap: 4px 8px; }
+.checks .detail { grid-column: 2 / -1; color: var(--muted); font-size: 12px; word-break: break-all; }
+.notice { margin: 0 0 16px; padding: 10px 12px; border-radius: 6px; background: var(--warn-soft); color: var(--warn); }
+.status-line { margin-right: auto; align-self: center; color: var(--muted); font-size: 13px; }
+.actions .status-line { margin-right: 0; }
+
+/* Terminal dock */
+.terminal { display: grid; grid-template-rows: 6px 34px minmax(0, 1fr); min-height: 0; background: var(--term-bg); color: var(--term-text); border-top: 1px solid var(--control-border); }
+.resize { cursor: row-resize; background: transparent; }
+.resize:hover, .resize:focus-visible { background: var(--accent); outline: none; }
+.term-bar { display: flex; align-items: center; gap: 4px; padding: 0 8px 0 14px; font: 600 11px/1 var(--font); letter-spacing: .06em; color: var(--term-muted); }
+.term-tabs { display: flex; gap: 16px; }
+.term-tabs [role="tab"] { padding: 6px 0; border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--term-muted); cursor: pointer; font: inherit; letter-spacing: inherit; }
+.term-tabs [role="tab"][aria-selected="true"] { color: var(--term-text); border-bottom-color: var(--term-prompt); }
+.term-bar .grow { flex: 1; }
+.icon-btn { width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 5px; background: transparent; color: var(--term-muted); cursor: pointer; }
+.icon-btn:hover { background: rgb(255 255 255 / .08); color: var(--term-text); }
+.icon-btn svg { width: 16px; height: 16px; }
+.term-bodies { position: relative; min-height: 0; overflow: hidden; }
+.term-body { position: absolute; inset: 4px 0 6px 14px; }
+.term-toggle { display: flex; align-items: center; gap: 8px; height: 28px; padding: 0 14px; border: 0; border-top: 1px solid var(--border); background: var(--sidebar); color: var(--muted); cursor: pointer; font-size: 12px; text-align: left; }
+.term-toggle kbd { font: 12px var(--mono); }
+
+@media (prefers-reduced-motion: reduce) { .sidebar { transition: none; } }
diff --git a/desktop/frontend/src/tabs.js b/desktop/frontend/src/tabs.js
new file mode 100644
index 0000000..79725d9
--- /dev/null
+++ b/desktop/frontend/src/tabs.js
@@ -0,0 +1,50 @@
+// Dock state: whether the terminal dock is showing, which tab is in front and
+// how tall it is. No DOM here, so node's test runner covers it; terminal.js
+// renders it. Each tab keeps its own xterm.js, so switching loses no output.
+
+export const TABS = ['kirokit', 'shell'];
+export const MIN_HEIGHT = 120;
+export const MAX_HEIGHT = 480;
+const DEFAULT_HEIGHT = 220;
+
+const clamp = (h) => Math.max(MIN_HEIGHT, Math.min(MAX_HEIGHT, Math.round(h)));
+
+export function createDock({ height = DEFAULT_HEIGHT, open = false, tab = 'kirokit' } = {}) {
+  const state = { open, tab, height: clamp(height) };
+  const listeners = new Set();
+  const emit = () => listeners.forEach((fn) => fn(state));
+
+  return {
+    get open() { return state.open; },
+    get tab() { return state.tab; },
+    get height() { return state.height; },
+    show() {
+      state.open = true;
+      emit();
+    },
+    hide() {
+      state.open = false;
+      emit();
+    },
+    toggle() {
+      state.open = !state.open;
+      emit();
+    },
+    // Selecting a tab brings the dock up, so a command's output is never hidden.
+    select(next) {
+      if (!TABS.includes(next)) return;
+      state.tab = next;
+      state.open = true;
+      emit();
+    },
+    resize(h) {
+      if (!Number.isFinite(h)) return;
+      state.height = clamp(h);
+      emit();
+    },
+    subscribe(fn) {
+      listeners.add(fn);
+      return () => listeners.delete(fn);
+    },
+  };
+}
diff --git a/desktop/frontend/src/terminal.js b/desktop/frontend/src/terminal.js
new file mode 100644
index 0000000..6eb37d4
--- /dev/null
+++ b/desktop/frontend/src/terminal.js
@@ -0,0 +1,152 @@
+// The terminal dock: two xterm.js terminals, "kirokit" for button commands and
+// "zsh" for the person's own shell, in one resizable panel. State lives in
+// tabs.js; this file draws it and talks to Go through api.js.
+import { Terminal } from '@xterm/xterm';
+import { FitAddon } from '@xterm/addon-fit';
+import '@xterm/xterm/css/xterm.css';
+import * as api from './api.js';
+import { MIN_HEIGHT, MAX_HEIGHT, TABS } from './tabs.js';
+
+const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
+
+function theme() {
+  return {
+    background: css('--term-bg'),
+    foreground: css('--term-text'),
+    cursor: css('--term-prompt'),
+    selectionBackground: css('--accent-soft'),
+  };
+}
+
+// Go sends terminal bytes as base64 so no escape sequence is mangled in JSON.
+function decode(b64) {
+  const raw = atob(b64);
+  const bytes = new Uint8Array(raw.length);
+  for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
+  return bytes;
+}
+
+function makeTerm(host) {
+  const term = new Terminal({
+    fontFamily: css('--mono'),
+    fontSize: 13,
+    lineHeight: 1.2,
+    cursorBlink: true,
+    scrollback: 5000,
+    theme: theme(),
+  });
+  const fit = new FitAddon();
+  term.loadAddon(fit);
+  term.open(host);
+  return { term, fit, host };
+}
+
+// initDock wires the dock markup in index.html to the dock state.
+export function initDock(dock) {
+  const panel = document.getElementById('terminal');
+  const toggle = document.getElementById('term-open');
+  const handle = document.getElementById('resize');
+  const tabButtons = Object.fromEntries(TABS.map((t) => [t, document.getElementById('tab-' + t)]));
+  const terms = {
+    kirokit: makeTerm(document.getElementById('term-kirokit')),
+    shell: makeTerm(document.getElementById('term-shell')),
+  };
+  let runId = 0;
+  let running = false;
+
+  // The kirokit tab takes input only while a command runs (git sign-in).
+  const setRunning = (on) => { running = on; terms.kirokit.term.options.disableStdin = !on; };
+  setRunning(false);
+  terms.kirokit.term.writeln('\x1b[2mButtons run their kirokit command here. Type your own commands in the zsh tab.\x1b[0m');
+
+  terms.kirokit.term.onData((data) => { if (running) api.runWrite(runId, data); });
+  terms.shell.term.onData((data) => api.shellWrite(data));
+  terms.shell.term.onResize(({ cols, rows }) => api.shellResize(cols, rows));
+
+  // Fitting a hidden terminal measures nothing, so only the front tab of an
+  // open dock is fitted. A fit that changes the size reaches Go through onResize.
+  function refit() {
+    if (!dock.open) return;
+    const front = terms[dock.tab];
+    front.fit.fit();
+    // The shell has not heard its size when the fit changed nothing yet.
+    if (dock.tab === 'shell') api.shellResize(front.term.cols, front.term.rows);
+  }
+
+  function render({ open, tab, height }) {
+    panel.hidden = !open;
+    toggle.hidden = open;
+    panel.style.height = height + 'px';
+    handle.setAttribute('aria-valuenow', height);
+    for (const t of TABS) {
+      tabButtons[t].setAttribute('aria-selected', String(t === tab));
+      tabButtons[t].tabIndex = t === tab ? 0 : -1;
+      terms[t].host.hidden = t !== tab;
+    }
+    requestAnimationFrame(() => {
+      refit();
+      if (open) terms[tab].term.focus();
+    });
+  }
+  dock.subscribe(render);
+  render(dock);
+
+  toggle.addEventListener('click', () => dock.show());
+  document.getElementById('term-close').addEventListener('click', () => dock.hide());
+  document.getElementById('term-clear').addEventListener('click', () => terms[dock.tab].term.clear());
+  for (const t of TABS) tabButtons[t].addEventListener('click', () => dock.select(t));
+  document.getElementById('term-tabs').addEventListener('keydown', (e) => {
+    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+    const next = TABS[(TABS.indexOf(dock.tab) + (e.key === 'ArrowRight' ? 1 : TABS.length - 1)) % TABS.length];
+    dock.select(next);
+    tabButtons[next].focus();
+    e.preventDefault();
+  });
+  document.addEventListener('keydown', (e) => {
+    if (e.ctrlKey && !e.metaKey && e.key === '`') {
+      dock.toggle();
+      e.preventDefault();
+    }
+  });
+
+  // Dragging the top edge, or Arrow Up and Down on it, resizes the dock.
+  handle.addEventListener('pointerdown', (e) => {
+    const startY = e.clientY;
+    const startH = dock.height;
+    handle.setPointerCapture(e.pointerId);
+    const move = (m) => dock.resize(startH + (startY - m.clientY));
+    const up = () => {
+      handle.removeEventListener('pointermove', move);
+      handle.removeEventListener('pointerup', up);
+    };
+    handle.addEventListener('pointermove', move);
+    handle.addEventListener('pointerup', up);
+  });
+  handle.addEventListener('keydown', (e) => {
+    if (e.key === 'ArrowUp') dock.resize(dock.height + 20);
+    else if (e.key === 'ArrowDown') dock.resize(dock.height - 20);
+    else return;
+    e.preventDefault();
+  });
+  handle.setAttribute('aria-valuemin', MIN_HEIGHT);
+  handle.setAttribute('aria-valuemax', MAX_HEIGHT);
+
+  // A window resize changes the panel's width; a dock resize is handled by
+  // render. Either way the front terminal is refitted.
+  new ResizeObserver(() => refit()).observe(document.getElementById('term-bodies'));
+
+  api.on('term:shell', ({ b64 }) => terms.shell.term.write(decode(b64)));
+  api.on('term:kirokit', ({ id, b64 }) => {
+    if (id !== runId) {
+      runId = id;
+      setRunning(true);
+      dock.select('kirokit');
+    }
+    terms.kirokit.term.write(decode(b64));
+  });
+  api.on('term:kirokit:exit', ({ id, code }) => {
+    if (id !== runId) return;
+    setRunning(false);
+    if (code !== 0) terms.kirokit.term.write(`\r\n\x1b[2mexited with code ${code}\x1b[0m\r\n`);
+  });
+}
diff --git a/desktop/frontend/vite.config.js b/desktop/frontend/vite.config.js
new file mode 100644
