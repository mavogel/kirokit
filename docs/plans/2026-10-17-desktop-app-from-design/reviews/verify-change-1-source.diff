diff --git a/desktop/catalog.go b/desktop/catalog.go
new file mode 100644
index 0000000..714134e
--- /dev/null
+++ b/desktop/catalog.go
@@ -0,0 +1,244 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/mavogel/kirokit/internal/externalskills"
+	"github.com/mavogel/kirokit/internal/manifest"
+	"github.com/mavogel/kirokit/internal/mcpversions"
+	"github.com/mavogel/kirokit/internal/render"
+)
+
+// Catalog is what the Teams, Agents and Skills pages render. Tag is the
+// release the clone sits on, empty when it is on a branch.
+type Catalog struct {
+	Teams []Team            `json:"teams"`
+	Pins  map[string]string `json:"pins"`
+	Tag   string            `json:"tag"`
+}
+
+// Team is one folder under teams/, as rendered.
+type Team struct {
+	Name      string   `json:"name"`
+	Agents    []Agent  `json:"agents"`
+	Skills    []Skill  `json:"skills"`
+	Prompts   int      `json:"prompts"`
+	Steerings []string `json:"steerings"`
+}
+
+// Agent is one rendered agent file. NeedsKey is true when the agent ships an
+// encrypted secrets file.
+type Agent struct {
+	Name        string   `json:"name"`
+	Description string   `json:"description"`
+	Tools       []string `json:"tools"`
+	Servers     []string `json:"servers"`
+	NeedsKey    bool     `json:"needsKey"`
+}
+
+// Skill's Source is "Written by the team" or "<source> @ <ref>".
+type Skill struct {
+	Name   string `json:"name"`
+	Source string `json:"source"`
+}
+
+const teamSkillSource = "Written by the team"
+
+// BuildCatalog renders every team of the repository at repo into a temporary
+// folder and reads the result. A team that fails to render fails the whole
+// catalog with an error naming it, so a page shows the message instead of a
+// partial table.
+func BuildCatalog(repo string) (Catalog, error) {
+	teamsRoot := filepath.Join(repo, "teams")
+	globalRoot := filepath.Join(repo, "global", "steerings")
+	versionsPath := filepath.Join(repo, "env", "mcp-versions.yaml")
+
+	cat := Catalog{Teams: []Team{}, Pins: map[string]string{}, Tag: repoTag(repo)}
+	if pins, err := mcpversions.Load(versionsPath); err == nil {
+		cat.Pins = pins
+	} else if !errors.Is(err, fs.ErrNotExist) {
+		return Catalog{}, err
+	}
+
+	entries, err := os.ReadDir(teamsRoot)
+	if err != nil {
+		return Catalog{}, fmt.Errorf("catalog: %w", err)
+	}
+	scratch, err := os.MkdirTemp("", "kirokit-catalog-*")
+	if err != nil {
+		return Catalog{}, fmt.Errorf("catalog: %w", err)
+	}
+	defer os.RemoveAll(scratch) //nolint:errcheck // a leftover temp folder is harmless
+
+	for _, e := range entries {
+		if !e.IsDir() {
+			continue
+		}
+		if _, err := os.Stat(filepath.Join(teamsRoot, e.Name(), "manifest.yaml")); err != nil {
+			continue
+		}
+		out := filepath.Join(scratch, e.Name())
+		if err := render.RenderTeam(teamsRoot, e.Name(), globalRoot, versionsPath, out, ""); err != nil {
+			return Catalog{}, fmt.Errorf("team %s: %w", e.Name(), err)
+		}
+		team, err := readTeam(teamsRoot, e.Name(), out)
+		if err != nil {
+			return Catalog{}, fmt.Errorf("team %s: %w", e.Name(), err)
+		}
+		cat.Teams = append(cat.Teams, team)
+	}
+	return cat, nil
+}
+
+func readTeam(teamsRoot, name, rendered string) (Team, error) {
+	teamDir := filepath.Join(teamsRoot, name)
+	team := Team{Name: name, Agents: []Agent{}, Skills: []Skill{}, Steerings: []string{}}
+
+	agentFiles, _ := filepath.Glob(filepath.Join(rendered, "agents", "*.json"))
+	sort.Strings(agentFiles)
+	for _, f := range agentFiles {
+		data, err := os.ReadFile(f)
+		if err != nil {
+			return team, err
+		}
+		var doc struct {
+			Name        string                     `json:"name"`
+			Description string                     `json:"description"`
+			Tools       []string                   `json:"tools"`
+			McpServers  map[string]json.RawMessage `json:"mcpServers"`
+		}
+		if err := json.Unmarshal(data, &doc); err != nil {
+			return team, fmt.Errorf("%s: %w", filepath.Base(f), err)
+		}
+		file := strings.TrimSuffix(filepath.Base(f), ".json")
+		a := Agent{Name: doc.Name, Description: doc.Description, Tools: nonNil(doc.Tools), Servers: []string{}}
+		if a.Name == "" {
+			a.Name = file
+		}
+		for s := range doc.McpServers {
+			a.Servers = append(a.Servers, s)
+		}
+		sort.Strings(a.Servers)
+		_, statErr := os.Stat(filepath.Join(teamDir, "agents", file, "env", "secrets.enc.yaml"))
+		a.NeedsKey = statErr == nil
+		team.Agents = append(team.Agents, a)
+	}
+
+	lock, err := externalskills.ReadLock(externalskills.LockPath(teamDir))
+	if err != nil {
+		return team, err
+	}
+	external := map[string]string{}
+	for _, le := range lock.Skills {
+		external[le.Name] = le.Source + " @ " + le.Ref
+	}
+	if dirs, err := os.ReadDir(filepath.Join(rendered, "skills")); err == nil {
+		for _, d := range dirs {
+			if !d.IsDir() {
+				continue
+			}
+			src, ok := external[d.Name()]
+			if !ok {
+				src = teamSkillSource
+			}
+			team.Skills = append(team.Skills, Skill{Name: d.Name(), Source: src})
+		}
+	}
+
+	prompts, _ := filepath.Glob(filepath.Join(rendered, "prompts", "*"))
+	team.Prompts = len(prompts)
+
+	seen := map[string]bool{}
+	if files, err := os.ReadDir(filepath.Join(rendered, "steering")); err == nil {
+		for _, f := range files {
+			n := strings.TrimSuffix(f.Name(), filepath.Ext(f.Name()))
+			seen[n] = true
+			team.Steerings = append(team.Steerings, n)
+		}
+	}
+	if m, err := manifest.Load(filepath.Join(teamDir, "manifest.yaml")); err == nil {
+		for _, g := range m.GlobalSteerings {
+			if !seen[g] {
+				team.Steerings = append(team.Steerings, g)
+			}
+		}
+	}
+	sort.Strings(team.Steerings)
+	return team, nil
+}
+
+func nonNil(s []string) []string {
+	if s == nil {
+		return []string{}
+	}
+	return s
+}
+
+// repoTag is the release tag the clone is on, empty on a branch or when git
+// cannot say. GIT_* variables are dropped so git reads the clone itself.
+func repoTag(repo string) string {
+	cmd := exec.Command("git", "-C", repo, "describe", "--tags", "--exact-match", "HEAD")
+	cmd.Env = withoutGitEnv(os.Environ())
+	out, err := cmd.Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func withoutGitEnv(env []string) []string {
+	out := make([]string, 0, len(env))
+	for _, kv := range env {
+		if !strings.HasPrefix(kv, "GIT_") {
+			out = append(out, kv)
+		}
+	}
+	return out
+}
+
+// catalogCache holds the last build until a clone or sync ends.
+type catalogCache struct {
+	mu    sync.Mutex
+	built bool
+	cat   Catalog
+	err   error
+}
+
+// Catalog returns the teams as rendered from the clone. The result is cached:
+// it is built the first time it is asked for and again only after a clone or
+// a sync ends. Before a clone it is empty. A render error comes back as the
+// error, with its message.
+func (a *App) Catalog() (Catalog, error) {
+	a.cat.mu.Lock()
+	defer a.cat.mu.Unlock()
+	if !a.cat.built {
+		a.cat.build(a.repoDir())
+	}
+	return a.cat.cat, a.cat.err
+}
+
+// refreshCatalog rebuilds the cached catalog; the code that ends a clone or a
+// sync calls it.
+func (a *App) refreshCatalog() {
+	a.cat.mu.Lock()
+	defer a.cat.mu.Unlock()
+	a.cat.build(a.repoDir())
+}
+
+func (c *catalogCache) build(repo string) {
+	c.built = true
+	if _, err := os.Stat(filepath.Join(repo, "teams")); err != nil {
+		c.cat, c.err = Catalog{Teams: []Team{}, Pins: map[string]string{}}, nil
+		return
+	}
+	c.cat, c.err = BuildCatalog(repo)
+}
diff --git a/desktop/catalog_test.go b/desktop/catalog_test.go
new file mode 100644
index 0000000..cabb5ca
--- /dev/null
+++ b/desktop/catalog_test.go
@@ -0,0 +1,183 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/mavogel/kirokit/internal/externalskills"
+)
+
+func write(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func findTeam(t *testing.T, c Catalog, name string) Team {
+	t.Helper()
+	for _, tm := range c.Teams {
+		if tm.Name == name {
+			return tm
+		}
+	}
+	t.Fatalf("catalog has no team %q: %+v", name, c.Teams)
+	return Team{}
+}
+
+func findAgent(t *testing.T, tm Team, name string) Agent {
+	t.Helper()
+	for _, a := range tm.Agents {
+		if a.Name == name {
+			return a
+		}
+	}
+	t.Fatalf("team %s has no agent %q: %+v", tm.Name, name, tm.Agents)
+	return Agent{}
+}
+
+// The repository's own two teams are the fixture: names, descriptions, tools
+// and servers come from the rendered agent files, not from the page.
+func TestCatalog_ReadsRealTeams(t *testing.T) {
+	cat, err := BuildCatalog("..")
+	if err != nil {
+		t.Fatalf("BuildCatalog: %v", err)
+	}
+
+	names := []string{}
+	for _, tm := range cat.Teams {
+		names = append(names, tm.Name)
+	}
+	if !slices.Equal(names, []string{"data-team", "platform-team"}) {
+		t.Fatalf("teams = %v, want data-team and platform-team", names)
+	}
+
+	devops := findAgent(t, findTeam(t, cat, "platform-team"), "devops")
+	if !strings.HasPrefix(devops.Description, "Triages and resolves Jira tickets") {
+		t.Errorf("devops description = %q", devops.Description)
+	}
+	if !slices.Contains(devops.Tools, "shell") || !slices.Contains(devops.Tools, "@atlassian") {
+		t.Errorf("devops tools = %v, want shell and @atlassian", devops.Tools)
+	}
+	if !slices.Equal(devops.Servers, []string{"atlassian", "context7"}) {
+		t.Errorf("devops servers = %v, want atlassian and context7", devops.Servers)
+	}
+	if cat.Pins["jira-mcp"] != "1.4.2" {
+		t.Errorf("Pins[jira-mcp] = %q, want 1.4.2 from env/mcp-versions.yaml", cat.Pins["jira-mcp"])
+	}
+}
+
+// NeedsKey follows the encrypted secrets file in the source tree.
+func TestCatalog_NeedsKeyExactlyForShippedSecrets(t *testing.T) {
+	cat, err := BuildCatalog("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]bool{"platform-team/devops": true, "platform-team/platformdev": true, "data-team/javadev": true, "data-team/godev": false}
+	for key, needs := range want {
+		team, agent, _ := strings.Cut(key, "/")
+		if got := findAgent(t, findTeam(t, cat, team), agent).NeedsKey; got != needs {
+			t.Errorf("%s NeedsKey = %v, want %v", key, got, needs)
+		}
+	}
+}
+
+func fixtureRepo(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	write(t, filepath.Join(root, "env", "mcp-versions.yaml"), "tool-mcp: \"2.0.0\"\n")
+	write(t, filepath.Join(root, "teams", "t1", "manifest.yaml"), "team: t1\nglobalSteerings: []\n")
+	write(t, filepath.Join(root, "teams", "t1", "agents", "a1", "agent.json.tmpl"),
+		`{"name": "a1", "description": "d", "tools": ["read"], "mcpServers": {"tool-mcp": {"command": "x", "args": ["{{ mcpVersion "tool-mcp" }}"]}}}`)
+	write(t, filepath.Join(root, "teams", "t1", "skills", "own-skill", "SKILL.md"), "---\nname: own-skill\n---\n")
+	return root
+}
+
+// lockSkill declares a vendored skill in the team's manifest and lock, with
+// the real hash of its files: render refuses a lock that does not match.
+func lockSkill(t *testing.T, root, team, name, source, ref string) {
+	t.Helper()
+	teamDir := filepath.Join(root, "teams", team)
+	write(t, filepath.Join(teamDir, "manifest.yaml"),
+		"team: "+team+"\nglobalSteerings: []\nexternalSkills:\n  - source: "+source+"\n    ref: "+ref+"\n    paths:\n      - skills/"+name+"\n")
+	sum, err := externalskills.HashDir(filepath.Join(externalskills.SkillsDir(teamDir), name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	lock := externalskills.Lock{Skills: []externalskills.LockEntry{{Name: name, Source: source, Ref: ref, Path: "skills/" + name, Commit: "abc123", SHA256: sum}}}
+	if err := externalskills.WriteLock(externalskills.LockPath(teamDir), lock); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCatalog_SkillSources(t *testing.T) {
+	root := fixtureRepo(t)
+	write(t, filepath.Join(root, "teams", "t1", "external", "skills", "ext-skill", "SKILL.md"), "---\nname: ext-skill\n---\n")
+	lockSkill(t, root, "t1", "ext-skill", "https://example.com/skills.git", "v1.2.0")
+
+	cat, err := BuildCatalog(root)
+	if err != nil {
+		t.Fatalf("BuildCatalog: %v", err)
+	}
+	got := map[string]string{}
+	for _, s := range findTeam(t, cat, "t1").Skills {
+		got[s.Name] = s.Source
+	}
+	want := map[string]string{"own-skill": "Written by the team", "ext-skill": "https://example.com/skills.git @ v1.2.0"}
+	for name, src := range want {
+		if got[name] != src {
+			t.Errorf("skill %s source = %q, want %q (all: %v)", name, got[name], src, got)
+		}
+	}
+}
+
+// A template that cannot render reaches the page as an error with its
+// message; nothing panics and no half-built table is returned.
+func TestCatalog_RenderErrorCarriesMessage(t *testing.T) {
+	root := fixtureRepo(t)
+	write(t, filepath.Join(root, "teams", "t1", "agents", "a1", "agent.json.tmpl"), `{"v": "{{ mcpVersion "undefined-key" }}"}`)
+
+	_, err := BuildCatalog(root)
+
+	if err == nil || !strings.Contains(err.Error(), "undefined-key") || !strings.Contains(err.Error(), "t1") {
+		t.Errorf("err = %v, want one naming team t1 and the undefined key", err)
+	}
+}
+
+// Catalog() serves the cached result until a clone or sync ends.
+func TestCatalog_CachedUntilRefresh(t *testing.T) {
+	a := NewAppAt(t.TempDir())
+	root := fixtureRepo(t)
+	if err := os.Rename(root, a.repoDir()); err != nil {
+		t.Fatal(err)
+	}
+
+	first, err := a.Catalog()
+	if err != nil || len(first.Teams) != 1 {
+		t.Fatalf("Catalog = %+v, %v; want one team", first, err)
+	}
+	write(t, filepath.Join(a.repoDir(), "teams", "t2", "manifest.yaml"), "team: t2\nglobalSteerings: []\n")
+
+	again, _ := a.Catalog()
+	if len(again.Teams) != 1 {
+		t.Errorf("a second call re-read the clone: %d teams, want the cached 1", len(again.Teams))
+	}
+	a.refreshCatalog()
+	fresh, _ := a.Catalog()
+	if len(fresh.Teams) != 2 {
+		t.Errorf("after refreshCatalog %d teams, want 2", len(fresh.Teams))
+	}
+}
+
+func TestCatalog_NoCloneIsEmptyNotAnError(t *testing.T) {
+	cat, err := NewAppAt(t.TempDir()).Catalog()
+	if err != nil || len(cat.Teams) != 0 {
+		t.Errorf("Catalog = %+v, %v; want empty and no error before a clone", cat, err)
+	}
+}
diff --git a/desktop/clone.go b/desktop/clone.go
new file mode 100644
index 0000000..a99d7eb
--- /dev/null
+++ b/desktop/clone.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// cloneResult is the payload of clone:done. A true OK with an Error is the
+// "no release yet" case: the clone is kept and the message is shown.
+type cloneResult struct {
+	OK    bool   `json:"ok"`
+	Error string `json:"error"`
+}
+
+const noReleaseMessage = "This repository has no release yet (no v* tag). Ask your team lead to tag one."
+
+// Clone fetches the repository at address into <app folder>/repo and checks
+// out its newest release tag. A refused address or a command already running
+// comes back as the error; the rest runs in the kirokit tab and ends with
+// clone:done.
+func (a *App) Clone(address string) error {
+	address = strings.TrimSpace(address)
+	if !repoURLPattern.MatchString(address) {
+		return errors.New(repoURLMessage) //nolint:staticcheck // shown to the person beside the address field
+	}
+	cli, err := BundledCLI()
+	if err != nil {
+		return err
+	}
+	if err := a.reserve(); err != nil {
+		return err
+	}
+
+	s := a.loadSettings()
+	s.RepoURL = address
+	if err := a.writeSettings(s); err != nil {
+		a.release()
+		return err
+	}
+	go func() {
+		defer a.release()
+		a.emit("clone:done", a.cloneAndSync(address, cli))
+	}()
+	return nil
+}
+
+// cloneAndSync keeps any old clone under another name, clones the address and
+// syncs to the newest tag. A failure puts the old clone back.
+func (a *App) cloneAndSync(address, cli string) cloneResult {
+	repo := a.repoDir()
+	var old string
+	if _, err := os.Stat(repo); err == nil {
+		stamp := fmt.Sprintf("%s.old-%d", repo, time.Now().Unix())
+		old = stamp
+		for n := 2; exists(old); n++ {
+			old = stamp + "-" + strconv.Itoa(n)
+		}
+		if err := os.Rename(repo, old); err != nil {
+			return cloneResult{Error: "Could not set the old copy aside: " + err.Error()}
+		}
+	}
+	fail := func(message string) cloneResult {
+		_ = os.RemoveAll(repo) //nolint:errcheck // a leftover partial clone is replaced by the next try
+		if old != "" {
+			_ = os.Rename(old, repo) //nolint:errcheck // reported through the missing clone
+		}
+		return cloneResult{Error: message}
+	}
+
+	git := "git"
+	if p, ok := a.loginEnv().Lookup("git"); ok {
+		git = p
+	}
+	res, err := a.runStep("git", git, []string{"clone", "--", address, repo})
+	if err != nil {
+		return fail(err.Error())
+	}
+	if res.Code != 0 {
+		return fail(fmt.Sprintf("git clone failed (exit %d). Check the address and your access, then try again.", res.Code))
+	}
+
+	res, err = a.runStep("kirokit", cli, []string{"sync", "--latest-tag"})
+	switch {
+	case err != nil:
+		return fail(err.Error())
+	case res.Code == 0:
+		return cloneResult{OK: true}
+	case strings.Contains(res.Tail, "no v* tag found"):
+		return cloneResult{OK: true, Error: noReleaseMessage}
+	default:
+		return fail(fmt.Sprintf("kirokit sync failed (exit %d). See the kirokit tab.", res.Code))
+	}
+}
+
+func exists(path string) bool {
+	_, err := os.Lstat(path)
+	return err == nil
+}
diff --git a/desktop/clone_test.go b/desktop/clone_test.go
new file mode 100644
index 0000000..4baac9f
--- /dev/null
+++ b/desktop/clone_test.go
@@ -0,0 +1,245 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// cleanGitEnv is the process environment without GIT_* variables, so a hook's
+// GIT_DIR cannot redirect the test repositories.
+func cleanGitEnv() []string { return withoutGitEnv(os.Environ()) }
+
+func git(t *testing.T, dir string, args ...string) string {
+	t.Helper()
+	cmd := exec.Command("git", append([]string{"-C", dir, "-c", "user.name=t", "-c", "user.email=t@example.com", "-c", "commit.gpgsign=false", "-c", "tag.gpgsign=false"}, args...)...)
+	cmd.Env = cleanGitEnv()
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("git %v: %v\n%s", args, err, out)
+	}
+	return strings.TrimSpace(string(out))
+}
+
+// newOrigin makes a repository with one team, tagged with tags.
+func newOrigin(t *testing.T, tags ...string) string {
+	t.Helper()
+	dir := t.TempDir()
+	git(t, dir, "init", "-q", "-b", "main")
+	write(t, filepath.Join(dir, "teams", "t1", "manifest.yaml"), "team: t1\nglobalSteerings: []\n")
+	write(t, filepath.Join(dir, "env", "mcp-versions.yaml"), "x-mcp: \"1\"\n")
+	git(t, dir, "add", "-A")
+	git(t, dir, "commit", "-q", "-m", "init")
+	for _, tag := range tags {
+		git(t, dir, "tag", tag)
+	}
+	return dir
+}
+
+var (
+	builtOnce sync.Once
+	builtCLI  string
+	builtErr  error
+)
+
+// realKirokit builds the repository's kirokit once for the whole test run.
+func realKirokit(t *testing.T) string {
+	t.Helper()
+	builtOnce.Do(func() {
+		dir, err := os.MkdirTemp("", "kirokit-clone-test-")
+		if err != nil {
+			builtErr = err
+			return
+		}
+		builtCLI = filepath.Join(dir, "kirokit")
+		// kirokit is the root module; the desktop module cannot build it.
+		cmd := exec.Command("go", "build", "-o", builtCLI, "./cmd/kirokit")
+		cmd.Dir = ".."
+		if out, err := cmd.CombinedOutput(); err != nil {
+			builtErr = &buildError{err, string(out)}
+		}
+	})
+	if builtErr != nil {
+		t.Fatal(builtErr)
+	}
+	return builtCLI
+}
+
+type buildError struct {
+	err error
+	out string
+}
+
+func (e *buildError) Error() string { return "go build kirokit: " + e.err.Error() + "\n" + e.out }
+
+func cloneApp(t *testing.T) (*App, *eventLog) {
+	t.Helper()
+	a, log, _ := runnerApp(t, "")
+	t.Setenv("KIROKIT_DESKTOP_CLI", realKirokit(t))
+	// The login environment needs git on its PATH and no inherited GIT_*.
+	a.captureFn = func() EnvCapture {
+		return EnvCapture{Vars: map[string]string{"HOME": t.TempDir(), "PATH": os.Getenv("PATH"), "SHELL": "/bin/sh"}}
+	}
+	a.refreshEnv()
+	return a, log
+}
+
+func (l *eventLog) waitClone(t *testing.T) cloneResult {
+	t.Helper()
+	l.wait(t, "clone:done", func() bool {
+		l.mu.Lock()
+		defer l.mu.Unlock()
+		return l.clone != nil
+	})
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return *l.clone
+}
+
+func TestClone_FetchesTheRepositoryAndTheNewestReleaseTag(t *testing.T) {
+	origin := newOrigin(t, "v1.0.0")
+	git(t, origin, "commit", "-q", "--allow-empty", "-m", "later")
+	git(t, origin, "tag", "v1.2.0")
+	git(t, origin, "commit", "-q", "--allow-empty", "-m", "untagged")
+	a, log := cloneApp(t)
+
+	if err := a.Clone(origin); err != nil {
+		t.Fatal(err)
+	}
+	res := log.waitClone(t)
+
+	if !res.OK || res.Error != "" {
+		t.Fatalf("clone:done = %+v, want ok", res)
+	}
+	repo := filepath.Join(a.dataDir, "repo")
+	if tag := git(t, repo, "describe", "--tags", "--exact-match", "HEAD"); tag != "v1.2.0" {
+		t.Errorf("clone is on %q, want v1.2.0", tag)
+	}
+	out := log.output()
+	if !strings.Contains(out, "▸ git clone -- "+origin+" "+repo) || !strings.Contains(out, "▸ kirokit sync --latest-tag") || !strings.Contains(out, "checked out v1.2.0 at") {
+		t.Errorf("the kirokit tab must show the git clone and the sync, got %q", out)
+	}
+	if !a.State().Cloned || a.State().Settings.RepoURL != origin {
+		t.Errorf("State = %+v, want cloned with the address saved", a.State())
+	}
+	if cat, err := a.Catalog(); err != nil || len(cat.Teams) != 1 || cat.Tag != "v1.2.0" {
+		t.Errorf("Catalog after the clone = %+v, %v; want team t1 on v1.2.0", cat, err)
+	}
+}
+
+func TestClone_RefusesAnAddressBeforeAnyProcessStarts(t *testing.T) {
+	a, log := cloneApp(t)
+	for _, address := range []string{"", "-oops", "--upload-pack=touch /tmp/x", "ftp://host/x", "relative/path", "has space /x"} {
+		if err := a.Clone(address); err == nil {
+			t.Errorf("Clone(%q) was accepted", address)
+		}
+	}
+	if out := log.output(); out != "" {
+		t.Errorf("a refused address must start no process, the kirokit tab got %q", out)
+	}
+	if got := a.State().Settings.RepoURL; got != "" {
+		t.Errorf("a refused address must not be saved, got %q", got)
+	}
+}
+
+func TestClone_RefusesWhileACommandRuns(t *testing.T) {
+	a, log := cloneApp(t)
+	origin := newOrigin(t, "v1.0.0")
+	cli := writeScript(t, t.TempDir(), "kirokit", `echo ready; read line`)
+	t.Setenv("KIROKIT_DESKTOP_CLI", cli)
+	id, err := a.Run([]string{"sync"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	log.waitOutput(t, "ready")
+
+	if err := a.Clone(origin); err == nil || err.Error() != "kirokit is still running a command" {
+		t.Fatalf("Clone error = %v, want the still-running message", err)
+	}
+	a.RunWrite(id, "\r")
+	log.waitExit(t)
+}
+
+func TestClone_ASecondAddressKeepsTheOldCloneUnderAnotherName(t *testing.T) {
+	first := newOrigin(t, "v1.0.0")
+	second := newOrigin(t, "v2.0.0")
+	a, log := cloneApp(t)
+	if err := a.Clone(first); err != nil {
+		t.Fatal(err)
+	}
+	log.waitClone(t)
+	log.clearClone()
+
+	if err := a.Clone(second); err != nil {
+		t.Fatal(err)
+	}
+	if res := log.waitClone(t); !res.OK {
+		t.Fatalf("clone:done = %+v", res)
+	}
+
+	repo := filepath.Join(a.dataDir, "repo")
+	if tag := git(t, repo, "describe", "--tags", "--exact-match", "HEAD"); tag != "v2.0.0" {
+		t.Errorf("repo is on %q, want v2.0.0", tag)
+	}
+	olds, _ := filepath.Glob(filepath.Join(a.dataDir, "repo.old-*"))
+	if len(olds) != 1 {
+		t.Fatalf("old clones = %v, want exactly one repo.old-<time>", olds)
+	}
+	if tag := git(t, olds[0], "describe", "--tags", "--exact-match", "HEAD"); tag != "v1.0.0" {
+		t.Errorf("old clone is on %q, want v1.0.0", tag)
+	}
+}
+
+func TestClone_AFailedCloneRestoresTheOldOneAndKeepsTheAddress(t *testing.T) {
+	good := newOrigin(t, "v1.0.0")
+	a, log := cloneApp(t)
+	if err := a.Clone(good); err != nil {
+		t.Fatal(err)
+	}
+	log.waitClone(t)
+	log.clearClone()
+
+	missing := filepath.Join(t.TempDir(), "no-such-origin")
+	if err := a.Clone(missing); err != nil {
+		t.Fatal(err)
+	}
+	res := log.waitClone(t)
+
+	if res.OK || res.Error == "" {
+		t.Fatalf("clone:done = %+v, want a failure with a message", res)
+	}
+	repo := filepath.Join(a.dataDir, "repo")
+	if tag := git(t, repo, "describe", "--tags", "--exact-match", "HEAD"); tag != "v1.0.0" {
+		t.Errorf("the old clone was not restored: repo is on %q", tag)
+	}
+	if olds, _ := filepath.Glob(filepath.Join(a.dataDir, "repo.old-*")); len(olds) != 0 {
+		t.Errorf("a restored clone leaves no repo.old-*, got %v", olds)
+	}
+	if got := a.State().Settings.RepoURL; got != missing {
+		t.Errorf("saved address = %q, want the failed address %q kept", got, missing)
+	}
+}
+
+func TestClone_AnOriginWithoutAReleaseTagKeepsTheClone(t *testing.T) {
+	origin := newOrigin(t)
+	a, log := cloneApp(t)
+
+	if err := a.Clone(origin); err != nil {
+		t.Fatal(err)
+	}
+	res := log.waitClone(t)
+
+	want := "This repository has no release yet (no v* tag). Ask your team lead to tag one."
+	if !res.OK || res.Error != want {
+		t.Errorf("clone:done = %+v, want ok with %q", res, want)
+	}
+	if !a.State().Cloned {
+		t.Error("the clone must be kept")
+	}
+	if cat, err := a.Catalog(); err != nil || len(cat.Teams) != 1 {
+		t.Errorf("Catalog = %+v, %v; the app works from the default branch", cat, err)
+	}
+}
diff --git a/desktop/envcapture.go b/desktop/envcapture.go
new file mode 100644
index 0000000..fd83aa5
--- /dev/null
+++ b/desktop/envcapture.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// captureMarker precedes the environment in the login shell's output, so
+// whatever the startup files print before it is ignored.
+const captureMarker = "__KIROKIT_ENV_BEGIN__"
+
+// captureTimeout is how long the login shell may take before the app moves on.
+const captureTimeout = 5 * time.Second
+
+// EnvCapture is the environment the person's login shell produces. A GUI app
+// starts with launchd's minimal PATH, so tools are looked up here instead.
+type EnvCapture struct {
+	Vars map[string]string
+	// Note is set when the capture fell back; Settings shows it.
+	Note string
+}
+
+// Getenv returns a captured variable, empty when unset.
+func (e EnvCapture) Getenv(name string) string { return e.Vars[name] }
+
+// Lookup resolves an executable on the captured PATH.
+func (e EnvCapture) Lookup(name string) (string, bool) {
+	for _, dir := range filepath.SplitList(e.Getenv("PATH")) {
+		if dir == "" {
+			continue
+		}
+		p := filepath.Join(dir, name)
+		if info, err := os.Stat(p); err == nil && !info.IsDir() && info.Mode().Perm()&0o111 != 0 {
+			return p, true
+		}
+	}
+	return "", false
+}
+
+// toolFolders are where Homebrew and per-user installs put sops and kiro-cli.
+func toolFolders(home string) []string {
+	return []string{"/opt/homebrew/bin", "/opt/homebrew/sbin", "/usr/local/bin", filepath.Join(home, ".local", "bin")}
+}
+
+// withToolFolders appends the tool folders missing from path, so a login shell
+// without startup files still finds Homebrew's tools.
+func withToolFolders(path, home string) string {
+	have := map[string]bool{}
+	var parts []string
+	for _, p := range filepath.SplitList(path) {
+		if p != "" {
+			have[p] = true
+			parts = append(parts, p)
+		}
+	}
+	for _, dir := range toolFolders(home) {
+		if !have[dir] {
+			parts = append(parts, dir)
+		}
+	}
+	return strings.Join(parts, ":")
+}
+
+// Capture runs shell as a login shell, reads the environment it prints after
+// captureMarker and returns it. When the shell fails or takes longer than
+// timeout, it returns the app's own environment with a fallback PATH and a
+// Note saying so.
+func Capture(shell string, timeout time.Duration) EnvCapture {
+	vars, note := runLoginShell(shell, timeout)
+	if vars == nil {
+		vars = map[string]string{}
+		for _, kv := range os.Environ() {
+			if k, v, ok := strings.Cut(kv, "="); ok {
+				vars[k] = v
+			}
+		}
+		vars["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
+	}
+	home := vars["HOME"]
+	if home == "" {
+		home = homeDir()
+	}
+	vars["PATH"] = withToolFolders(vars["PATH"], home)
+	return EnvCapture{Vars: vars, Note: note}
+}
+
+func runLoginShell(shell string, timeout time.Duration) (map[string]string, string) {
+	if shell == "" {
+		shell = "/bin/zsh"
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, shell, "-ilc", "printf '%s' '"+captureMarker+"'; exec env -0")
+	// The shell and everything it starts form one group, so a timeout ends all
+	// of it and releases the output pipe.
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
+	cmd.WaitDelay = time.Second
+	var out bytes.Buffer
+	cmd.Stdout = &out
+
+	if err := cmd.Run(); err != nil {
+		if ctx.Err() != nil {
+			return nil, "Your login shell took more than " + timeout.String() + " to start, so kirokit is using a default PATH. Tools outside it may not be found."
+		}
+		return nil, "Your login shell could not be read (" + err.Error() + "), so kirokit is using a default PATH."
+	}
+	_, env, ok := bytes.Cut(out.Bytes(), []byte(captureMarker))
+	if !ok {
+		return nil, "Your login shell printed no environment, so kirokit is using a default PATH."
+	}
+	vars := map[string]string{}
+	for _, kv := range bytes.Split(env, []byte{0}) {
+		if k, v, ok := bytes.Cut(kv, []byte("=")); ok && len(k) > 0 {
+			vars[string(k)] = string(v)
+		}
+	}
+	return vars, ""
+}
diff --git a/desktop/envcapture_test.go b/desktop/envcapture_test.go
new file mode 100644
index 0000000..b657c24
--- /dev/null
+++ b/desktop/envcapture_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// fakeShell writes an executable script standing in for the login shell. It
+// ignores the -ilc arguments and runs body.
+func fakeShell(t *testing.T, body string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "fakesh")
+	if err := os.WriteFile(p, []byte("#!/bin/sh\n"+body+"\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// Startup files print banners before the marker; only what follows it is the
+// environment. Reading everything would turn the banner into a variable name.
+func TestCapture_ReadsOnlyAfterMarker(t *testing.T) {
+	sh := fakeShell(t, `echo "Welcome back, banner=noise"; printf '%s' '`+captureMarker+`'; exec env -0`)
+	t.Setenv("KIRO_HOME", "/captured/kiro")
+
+	got := Capture(sh, 5*time.Second)
+
+	if got.Note != "" {
+		t.Errorf("Note = %q, want none for a shell that answered", got.Note)
+	}
+	if v := got.Getenv("KIRO_HOME"); v != "/captured/kiro" {
+		t.Errorf("KIRO_HOME = %q, want /captured/kiro", v)
+	}
+	if _, ok := got.Vars["Welcome back, banner"]; ok {
+		t.Error("startup noise before the marker was read as environment")
+	}
+}
+
+// A shell that never answers must not hold the app: after the limit Capture
+// returns a usable PATH and a note for Settings.
+func TestCapture_SlowShellFallsBack(t *testing.T) {
+	sh := fakeShell(t, `sleep 10`)
+
+	start := time.Now()
+	got := Capture(sh, 200*time.Millisecond)
+
+	if d := time.Since(start); d > 3*time.Second {
+		t.Errorf("Capture took %v, want it to give up near the limit", d)
+	}
+	if got.Note == "" {
+		t.Error("Note is empty, want a message Settings can show")
+	}
+	for _, dir := range []string{"/opt/homebrew/bin", "/usr/local/bin"} {
+		if !strings.Contains(got.Getenv("PATH"), dir) {
+			t.Errorf("fallback PATH %q lacks %s", got.Getenv("PATH"), dir)
+		}
+	}
+}
+
+// A login shell without startup files reports a bare PATH; Homebrew's folder
+// is appended so sops and kiro-cli are still found.
+func TestCapture_AppendsToolFolders(t *testing.T) {
+	sh := fakeShell(t, `printf '%s' '`+captureMarker+`'; printf 'PATH=/usr/bin:/bin\0'`)
+
+	got := Capture(sh, 5*time.Second)
+
+	parts := strings.Split(got.Getenv("PATH"), ":")
+	if parts[0] != "/usr/bin" || parts[1] != "/bin" {
+		t.Errorf("PATH = %q, want the shell's folders first", got.Getenv("PATH"))
+	}
+	for _, dir := range []string{"/opt/homebrew/bin", "/opt/homebrew/sbin", "/usr/local/bin"} {
+		n := 0
+		for _, p := range parts {
+			if p == dir {
+				n++
+			}
+		}
+		if n != 1 {
+			t.Errorf("%s appears %d times in %q, want once", dir, n, got.Getenv("PATH"))
+		}
+	}
+}
