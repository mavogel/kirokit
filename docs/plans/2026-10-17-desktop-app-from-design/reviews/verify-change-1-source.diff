diff --git a/desktop/installs.go b/desktop/installs.go
new file mode 100644
index 0000000..fd83184
--- /dev/null
+++ b/desktop/installs.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"sync"
+	"time"
+
+	"github.com/mavogel/kirokit/internal/install"
+)
+
+// installsPollInterval is how often the install records are read.
+const installsPollInterval = time.Second
+
+// installPoller reads the install records under the Kiro home and emits
+// installs:changed when they differ from the last read.
+type installPoller struct {
+	home func() string
+	emit func(event string, data any)
+
+	mu   sync.Mutex // guards last
+	last []install.Record
+
+	stop     chan struct{}
+	done     chan struct{}
+	stopOnce sync.Once
+}
+
+// newInstallPoller takes the first reading as the baseline, so the pages'
+// own first load is not announced again, and starts checking every interval.
+// home is asked at each check, so a Settings change applies to the next one.
+func newInstallPoller(home func() string, emit func(event string, data any), interval time.Duration) *installPoller {
+	p := &installPoller{home: home, emit: emit, stop: make(chan struct{}), done: make(chan struct{})}
+	p.last, _ = install.Installed(home())
+	go p.run(interval)
+	return p
+}
+
+func (p *installPoller) run(interval time.Duration) {
+	defer close(p.done)
+	t := time.NewTicker(interval)
+	defer t.Stop()
+	for {
+		select {
+		case <-p.stop:
+			return
+		case <-t.C:
+			p.Check()
+		}
+	}
+}
+
+// Check reads the records now and emits installs:changed when they differ
+// from the previous read. A failed read keeps the previous state.
+func (p *installPoller) Check() {
+	records, err := install.Installed(p.home())
+	if err != nil {
+		return
+	}
+	p.mu.Lock()
+	changed := !sameRecords(p.last, records)
+	p.last = records
+	p.mu.Unlock()
+	if changed {
+		if records == nil {
+			records = []install.Record{}
+		}
+		p.emit("installs:changed", records)
+	}
+}
+
+// Stop ends the polling goroutine and waits for it. It is safe to call twice.
+func (p *installPoller) Stop() {
+	p.stopOnce.Do(func() { close(p.stop) })
+	<-p.done
+}
+
+func sameRecords(a, b []install.Record) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].Team != b[i].Team || a[i].Files != b[i].Files || !a[i].Modified.Equal(b[i].Modified) {
+			return false
+		}
+	}
+	return true
+}
+
+func (a *App) startInstallPoller() {
+	p := newInstallPoller(a.kiroHome, a.emit, installsPollInterval)
+	a.mu.Lock()
+	a.poller = p
+	a.mu.Unlock()
+}
+
+// Installs lists the teams installed under the Kiro home. The pages call it
+// once at start; installs:changed keeps them current after that.
+func (a *App) Installs() ([]install.Record, error) {
+	records, err := install.Installed(a.kiroHome())
+	if records == nil {
+		records = []install.Record{}
+	}
+	return records, err
+}
diff --git a/desktop/installs_test.go b/desktop/installs_test.go
new file mode 100644
index 0000000..7fce6e2
--- /dev/null
+++ b/desktop/installs_test.go
@@ -0,0 +1,134 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/mavogel/kirokit/internal/install"
+)
+
+type fakeEmitter struct {
+	mu     sync.Mutex
+	events []string
+	last   []install.Record
+}
+
+func (f *fakeEmitter) emit(event string, data any) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.events = append(f.events, event)
+	f.last, _ = data.([]install.Record)
+}
+
+func (f *fakeEmitter) count() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return len(f.events)
+}
+
+// installFixture installs a one-agent team into home.
+func installFixture(t *testing.T, home string) {
+	t.Helper()
+	root := t.TempDir()
+	roots := install.Roots{
+		TeamsRoot:       filepath.Join(root, "teams"),
+		GlobalRoot:      filepath.Join(root, "global", "steerings"),
+		EnvVersionsPath: filepath.Join(root, "env", "mcp-versions.yaml"),
+	}
+	write(t, roots.EnvVersionsPath, "x-mcp: \"1\"\n")
+	write(t, filepath.Join(roots.TeamsRoot, "t1", "manifest.yaml"), "team: t1\nglobalSteerings: []\n")
+	write(t, filepath.Join(roots.TeamsRoot, "t1", "agents", "a1", "agent.json.tmpl"), `{"name": "a1"}`)
+	if err := install.Install(roots, "t1", home, nil); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestInstalls_EmitsOnlyOnChange(t *testing.T) {
+	home := t.TempDir()
+	em := &fakeEmitter{}
+	p := newInstallPoller(func() string { return home }, em.emit, time.Hour)
+	defer p.Stop()
+
+	p.Check()
+	if em.count() != 0 {
+		t.Fatalf("an unchanged empty state emitted %d events, want none", em.count())
+	}
+
+	installFixture(t, home)
+	p.Check()
+	if em.count() != 1 || len(em.last) != 1 || em.last[0].Team != "t1" {
+		t.Fatalf("after install: events %v last %+v, want one with t1", em.events, em.last)
+	}
+	p.Check()
+	if em.count() != 1 {
+		t.Errorf("an unchanged state emitted again: %d events", em.count())
+	}
+
+	// A newer file time on the record is a change (a reinstall rewrites it).
+	record := filepath.Join(home, ".kirokit-installed", "t1.json")
+	later := time.Now().Add(time.Hour)
+	if err := os.Chtimes(record, later, later); err != nil {
+		t.Fatal(err)
+	}
+	p.Check()
+	if em.count() != 2 {
+		t.Errorf("a changed file time emitted %d events in total, want 2", em.count())
+	}
+
+	if err := install.Uninstall(home, "t1"); err != nil {
+		t.Fatal(err)
+	}
+	p.Check()
+	if em.count() != 3 || len(em.last) != 0 {
+		t.Errorf("after uninstall: events %d last %+v, want a third event with no records", em.count(), em.last)
+	}
+}
+
+// Settings can change the Kiro home between checks; the next check reads the
+// new folder.
+func TestInstalls_FollowsSettingsChange(t *testing.T) {
+	first, second := t.TempDir(), t.TempDir()
+	installFixture(t, second)
+	home := first
+	em := &fakeEmitter{}
+	p := newInstallPoller(func() string { return home }, em.emit, time.Hour)
+	defer p.Stop()
+
+	home = second
+	p.Check()
+
+	if em.count() != 1 || len(em.last) != 1 {
+		t.Errorf("after the home changed: events %d last %+v, want one event with t1", em.count(), em.last)
+	}
+}
+
+// The goroutine ticks on its own, and Stop ends it: nothing is emitted after
+// Stop returns.
+func TestInstalls_TicksThenStops(t *testing.T) {
+	home := t.TempDir()
+	em := &fakeEmitter{}
+	p := newInstallPoller(func() string { return home }, em.emit, 5*time.Millisecond)
+
+	installFixture(t, home)
+	deadline := time.Now().Add(5 * time.Second)
+	for em.count() == 0 && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if em.count() == 0 {
+		t.Fatal("the ticker never noticed the new record")
+	}
+
+	p.Stop()
+	before := em.count()
+	if err := install.Uninstall(home, "t1"); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if em.count() != before {
+		t.Error("an event arrived after Stop returned")
+	}
+	p.Stop() // a second Stop must not block or panic
+}
