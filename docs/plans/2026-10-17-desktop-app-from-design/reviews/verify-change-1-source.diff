+package install
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+)
+
+// installTeams installs the fixture team under each given name into kiroHome.
+func installTeams(t *testing.T, kiroHome string, names ...string) {
+	t.Helper()
+	roots, _, _ := setupFixture(t)
+	for _, name := range names {
+		mustWrite(t, filepath.Join(roots.TeamsRoot, name, "manifest.yaml"), "team: "+name+"\nglobalSteerings: []\n")
+		mustWrite(t, filepath.Join(roots.TeamsRoot, name, "agents", "agent-"+name, "agent.json.tmpl"),
+			`{"name": "agent-`+name+`"}`)
+	}
+	for _, name := range names {
+		if err := Install(roots, name, kiroHome, nil); err != nil {
+			t.Fatalf("Install %s: %v", name, err)
+		}
+	}
+}
+
+func TestInstalled_ListsRecordsSortedWithFileCountAndTime(t *testing.T) {
+	kiroHome := t.TempDir()
+	installTeams(t, kiroHome, "zeta-team", "alpha-team")
+
+	got, err := Installed(kiroHome)
+	if err != nil {
+		t.Fatalf("Installed: %v", err)
+	}
+	if len(got) != 2 || got[0].Team != "alpha-team" || got[1].Team != "zeta-team" {
+		t.Fatalf("Installed = %+v, want alpha-team then zeta-team", got)
+	}
+	for _, r := range got {
+		if r.Files < 1 {
+			t.Errorf("%s: Files = %d, want at least the agent file", r.Team, r.Files)
+		}
+		info, err := os.Stat(filepath.Join(kiroHome, ".kirokit-installed", r.Team+".json"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !r.Modified.Equal(info.ModTime()) {
+			t.Errorf("%s: Modified = %v, want the record's mtime %v", r.Team, r.Modified, info.ModTime())
+		}
+		if r.Modified.After(time.Now().Add(time.Minute)) {
+			t.Errorf("%s: Modified %v is in the future", r.Team, r.Modified)
+		}
+	}
+}
+
+func TestInstalled_MissingRecordsFolderIsEmpty(t *testing.T) {
+	got, err := Installed(t.TempDir())
+	if err != nil {
+		t.Fatalf("Installed on a fresh home: %v", err)
+	}
+	if len(got) != 0 {
+		t.Errorf("Installed = %+v, want none", got)
+	}
+}
+
+func TestUninstallOthers_RemovesEveryTeamButTheKeptOne(t *testing.T) {
+	kiroHome := t.TempDir()
+	installTeams(t, kiroHome, "a-team", "b-team", "c-team")
+
+	removed, err := UninstallOthers(kiroHome, "b-team")
+	if err != nil {
+		t.Fatalf("UninstallOthers: %v", err)
+	}
+	if want := []string{"a-team", "c-team"}; !reflect.DeepEqual(removed, want) {
+		t.Errorf("removed = %v, want %v", removed, want)
+	}
+	left, err := Installed(kiroHome)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(left) != 1 || left[0].Team != "b-team" {
+		t.Errorf("Installed after = %+v, want only b-team", left)
+	}
+	if _, err := os.Stat(filepath.Join(kiroHome, "agents", "agent-b-team.json")); err != nil {
+		t.Errorf("kept team's agent was touched: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(kiroHome, "agents", "agent-a-team.json")); !os.IsNotExist(err) {
+		t.Errorf("removed team's agent still exists (err=%v)", err)
+	}
+}
+
+func TestUninstallOthers_KeepingTheOnlyTeamRemovesNothing(t *testing.T) {
+	kiroHome := t.TempDir()
+	installTeams(t, kiroHome, "a-team")
+
+	removed, err := UninstallOthers(kiroHome, "a-team")
+	if err != nil || len(removed) != 0 {
+		t.Fatalf("UninstallOthers = %v, %v; want none", removed, err)
+	}
+}
+
+func TestUninstallOthers_FailedUninstallStopsAndReturnsTheError(t *testing.T) {
+	kiroHome := t.TempDir()
+	installTeams(t, kiroHome, "a-team", "b-team", "c-team")
+	// A corrupt record makes the first uninstall fail.
+	mustWrite(t, filepath.Join(kiroHome, ".kirokit-installed", "a-team.json"), "{not json")
+
+	removed, err := UninstallOthers(kiroHome, "c-team")
+	if err == nil {
+		t.Fatal("UninstallOthers returned nil for a corrupt record")
+	}
+	if len(removed) != 0 {
+		t.Errorf("removed = %v, want none before the failure", removed)
+	}
+	if _, statErr := os.Stat(filepath.Join(kiroHome, "agents", "agent-b-team.json")); statErr != nil {
+		t.Errorf("b-team was uninstalled after a-team failed: %v", statErr)
+	}
+}
diff --git a/scripts/desktop-build.sh b/scripts/desktop-build.sh
new file mode 100755
index 0000000..b1b5d54
--- /dev/null
+++ b/scripts/desktop-build.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# Build desktop/build/bin/kirokit.app: a universal Wails app with a universal
+# kirokit CLI at Contents/Resources/bin/kirokit.
+#
+# VERSION comes from the environment (the release job passes the new tag) and
+# defaults to `git describe`. A leading "v" is dropped, as GoReleaser does.
+set -euo pipefail
+
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$root"
+
+version="${VERSION:-$(git describe --tags --always --dirty)}"
+version="${version#v}"
+commit="$(git rev-parse HEAD)"
+date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+pkg="github.com/mavogel/kirokit/cmd/kirokit/commands"
+ldflags="-s -w -X ${pkg}.version=${version} -X ${pkg}.commit=${commit} -X ${pkg}.date=${date}"
+
+work="$(mktemp -d)"
+trap 'rm -rf "${work:?}"' EXIT
+
+for arch in amd64 arm64; do
+  CGO_ENABLED=0 GOOS=darwin GOARCH="$arch" \
+    go build -trimpath -ldflags "$ldflags" -o "$work/kirokit-$arch" ./cmd/kirokit
+done
+lipo -create -output "$work/kirokit" "$work/kirokit-amd64" "$work/kirokit-arm64"
+
+# macOS 13 is the app's minimum; without these the linker warns about mixed targets.
+export CGO_CFLAGS="-mmacosx-version-min=13.0"
+export CGO_LDFLAGS="-mmacosx-version-min=13.0"
+
+# -clean empties build/bin, so the CLI is copied in afterwards.
+(cd desktop && go run github.com/wailsapp/wails/v2/cmd/wails@v2.14.0 build -platform darwin/universal -clean)
+
+app="desktop/build/bin/kirokit.app"
+mkdir -p "$app/Contents/Resources/bin"
+install -m 0755 "$work/kirokit" "$app/Contents/Resources/bin/kirokit"
+# Wails sealed the bundle before the CLI joined it; seal it again (ad-hoc) so the signature stays valid.
+codesign --force --deep --sign - "$app"
+echo "built $app (version $version)"
diff --git a/scripts/desktop-release.sh b/scripts/desktop-release.sh
new file mode 100644
index 0000000..d72eae4
--- /dev/null
+++ b/scripts/desktop-release.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+# Zip the desktop app and render its Homebrew cask.
+#
+#   desktop-release.sh --version <v> --app <kirokit.app> --out <dir> [--publish]
+#
+# Without --publish nothing leaves the machine: the script writes
+#   <out>/kirokit-desktop_<version>_darwin_universal.zip
+#   <out>/Casks/kirokit-desktop.rb
+# and prints the zip's sha256. With --publish it also runs
+# `gh release upload v<version>` and pushes the cask to the default branch of
+# the tap repository (TAP_REPO, default mavogel/homebrew-tap). The push uses
+# HOMEBREW_TAP_GITHUB_TOKEN when set.
+set -euo pipefail
+
+repo="mavogel/kiro-cli-kit"
+tap="${TAP_REPO:-mavogel/homebrew-tap}"
+
+usage() { echo "usage: desktop-release.sh --version <version> --app <kirokit.app> --out <dir> [--publish]" >&2; }
+die() { echo "desktop-release: $*" >&2; usage; exit 1; }
+
+version="" app="" out="" publish=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --version) [ $# -ge 2 ] || die "--version needs a value"; version="$2"; shift 2 ;;
+    --app) [ $# -ge 2 ] || die "--app needs a value"; app="$2"; shift 2 ;;
+    --out) [ $# -ge 2 ] || die "--out needs a value"; out="$2"; shift 2 ;;
+    --publish) publish=1; shift ;;
+    *) die "unknown argument: $1" ;;
+  esac
+done
+
+version="${version#v}"
+[ -n "$version" ] || die "--version is required"
+[ -n "$app" ] || die "--app is required"
+[ -n "$out" ] || die "--out is required"
+[ -d "$app" ] || die "app folder not found: $app"
+[ "$(basename "$app")" = "kirokit.app" ] || die "the app folder must be named kirokit.app: $app"
+
+zip_name="kirokit-desktop_${version}_darwin_universal.zip"
+zip="$out/$zip_name"
+cask="$out/Casks/kirokit-desktop.rb"
+url="https://github.com/${repo}/releases/download/v${version}/${zip_name}"
+
+mkdir -p "$out/Casks"
+rm -f "$zip"
+ditto -c -k --keepParent "$app" "$zip"
+sha="$(shasum -a 256 "$zip" | awk '{print $1}')"
+
+cat > "$cask" <<EOF
+cask "kirokit-desktop" do
+  version "${version}"
+  sha256 "${sha}"
+
+  url "${url}"
+  name "kirokit"
+  desc "Desktop app to install and sync Kiro CLI team configs"
+  homepage "https://github.com/${repo}"
+
+  depends_on macos: ">= :ventura"
+
+  app "kirokit.app"
+
+  # The app is not notarized; without this macOS reports "kirokit is damaged".
+  postflight do
+    system_command "/usr/bin/xattr",
+                   args: ["-dr", "com.apple.quarantine", "#{appdir}/kirokit.app"]
+  end
+end
+EOF
+
+echo "zip:    $zip"
+echo "sha256: $sha"
+echo "cask:   $cask (Casks/kirokit-desktop.rb)"
+
+if [ "$publish" -eq 0 ]; then
+  echo "Dry run: nothing was uploaded or pushed (pass --publish to upload and push)."
+  exit 0
+fi
+
+gh release upload "v${version}" "$zip" --repo "$repo" --clobber
+
+work="$(mktemp -d)"
+trap 'rm -rf "${work:?}"' EXIT
+GH_TOKEN="${HOMEBREW_TAP_GITHUB_TOKEN:-${GH_TOKEN:-}}" gh repo clone "$tap" "$work/tap" -- --depth 1
+mkdir -p "$work/tap/Casks"
+cp "$cask" "$work/tap/Casks/kirokit-desktop.rb"
+git -C "$work/tap" add Casks/kirokit-desktop.rb
+if git -C "$work/tap" diff --cached --quiet; then
+  echo "cask already up to date in $tap"
+else
+  git -C "$work/tap" -c user.name="github-actions[bot]" -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
+    commit -m "kirokit-desktop ${version}"
+  GH_TOKEN="${HOMEBREW_TAP_GITHUB_TOKEN:-${GH_TOKEN:-}}" \
+    git -C "$work/tap" -c credential.helper='!gh auth git-credential' push
+fi
+echo "Published ${zip_name} to v${version} and the cask to ${tap}."
diff --git a/scripts/desktop-release_test.sh b/scripts/desktop-release_test.sh
new file mode 100644
index 0000000..7ef949b
--- /dev/null
+++ b/scripts/desktop-release_test.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Dry-run test for scripts/desktop-release.sh on a fake kirokit.app folder.
+set -euo pipefail
+
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+script="$root/scripts/desktop-release.sh"
+
+work="$(mktemp -d)"
+trap 'rm -rf "${work:?}"' EXIT
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+app="$work/kirokit.app"
+mkdir -p "$app/Contents/MacOS"
+echo "binary" > "$app/Contents/MacOS/kirokit"
+
+out="$work/out"
+log="$work/log"
+bash "$script" --version 1.2.3 --app "$app" --out "$out" > "$log" 2>&1 || { cat "$log" >&2; fail "dry run exited non-zero"; }
+
+zip="$out/kirokit-desktop_1.2.3_darwin_universal.zip"
+[ -f "$zip" ] || fail "zip missing: $zip"
+
+# The app folder is the zip's top level.
+first="$(unzip -Z1 "$zip" | head -n 1)"
+case "$first" in kirokit.app/*) ;; *) fail "first zip entry is '$first', want kirokit.app/..." ;; esac
+unzip -Z1 "$zip" | grep -qx 'kirokit.app/Contents/MacOS/kirokit' || fail "binary missing from zip"
+
+sha="$(shasum -a 256 "$zip" | awk '{print $1}')"
+cask="$out/Casks/kirokit-desktop.rb"
+[ -f "$cask" ] || fail "cask missing: $cask"
+
+check() { grep -qF -- "$1" "$cask" || { cat "$cask" >&2; fail "cask lacks: $1"; }; }
+check 'cask "kirokit-desktop" do'
+check 'version "1.2.3"'
+check "sha256 \"$sha\""
+check 'url "https://github.com/mavogel/kiro-cli-kit/releases/download/v1.2.3/kirokit-desktop_1.2.3_darwin_universal.zip"'
+check 'app "kirokit.app"'
+check 'postflight do'
+check '"/usr/bin/xattr"'
+check 'args: ["-dr", "com.apple.quarantine"'
+
+grep -qF "$sha" "$log" || fail "output lacks the sha256"
+grep -qF 'kirokit-desktop_1.2.3_darwin_universal.zip' "$log" || fail "output lacks the zip name"
+grep -qF 'Casks/kirokit-desktop.rb' "$log" || fail "output lacks the cask path"
+grep -qi 'nothing was uploaded or pushed' "$log" || fail "output must say nothing was uploaded or pushed"
+
+# A leading v on the version is accepted and dropped.
+bash "$script" --version v1.2.3 --app "$app" --out "$work/out-v" > /dev/null 2>&1 || fail "leading v rejected"
+[ -f "$work/out-v/kirokit-desktop_1.2.3_darwin_universal.zip" ] || fail "leading v not dropped"
+
+# Missing app folder and missing version fail with a message.
+if bash "$script" --version 1.2.3 --app "$work/nope.app" --out "$work/o2" > "$work/e1" 2>&1; then fail "missing app accepted"; fi
+[ -s "$work/e1" ] || fail "missing app gave no message"
+if bash "$script" --app "$app" --out "$work/o3" > "$work/e2" 2>&1; then fail "missing version accepted"; fi
+[ -s "$work/e2" ] || fail "missing version gave no message"
+
+echo "desktop-release_test: ok"
