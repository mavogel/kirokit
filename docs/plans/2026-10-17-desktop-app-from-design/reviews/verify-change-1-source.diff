@@ -0,0 +1,34 @@
+import { esc, chips, problem } from './html.js';
+
+// The rows of the agents table, or the message that replaces it.
+export function agentsView(view) {
+  const blocked = problem(view);
+  if (blocked) return { blocked: true, html: blocked };
+  const rows = [];
+  for (const t of view.catalog.teams || []) {
+    for (const a of t.agents) {
+      rows.push(`<tr>
+  <td class="mono">${esc(a.name)}</td>
+  <td>${esc(t.name)}</td>
+  <td class="desc">${esc(a.description)}</td>
+  <td>${chips(a.tools)}${chips(a.servers.map((s) => '@' + s).filter((s) => !a.tools.includes(s)))}</td>
+  <td>${a.needsKey ? '<span class="badge warn">needs key</span>' : '<span class="badge off">none</span>'}</td>
+</tr>`);
+    }
+  }
+  if (!rows.length) return { blocked: true, html: '<p class="note">No agents yet.</p>' };
+  return { blocked: false, html: rows.join('\n') };
+}
+
+export function initAgents(section) {
+  const body = section.querySelector('tbody');
+  const table = section.querySelector('table');
+  const message = document.createElement('div');
+  table.after(message);
+  return (view) => {
+    const out = agentsView(view);
+    table.hidden = out.blocked;
+    message.innerHTML = out.blocked ? out.html : '';
+    if (!out.blocked) body.innerHTML = out.html;
+  };
+}
diff --git a/desktop/frontend/src/pages/html.js b/desktop/frontend/src/pages/html.js
new file mode 100644
index 0000000..3fa8241
--- /dev/null
+++ b/desktop/frontend/src/pages/html.js
@@ -0,0 +1,50 @@
+// Helpers the page views share. Views return HTML strings built only from
+// escaped data, so node's test runner covers them without a DOM.
+
+export function esc(value) {
+  return String(value ?? '')
+    .replaceAll('&', '&amp;')
+    .replaceAll('<', '&lt;')
+    .replaceAll('>', '&gt;')
+    .replaceAll('"', '&quot;')
+    .replaceAll("'", '&#39;');
+}
+
+export function plural(n, one, many) {
+  return `${n} ${n === 1 ? one : many}`;
+}
+
+// A time as a <time> element: the machine value in datetime, the person's
+// local rendering as text.
+export function timeTag(iso) {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return '';
+  const text = d.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+  return `<time datetime="${esc(d.toISOString())}">${esc(text)}</time>`;
+}
+
+export function chips(items) {
+  return (items || []).map((i) => `<span class="chip">${esc(i)}</span>`).join('');
+}
+
+// What replaces a table when the catalog could not be read, or there is no
+// repository yet. Returns '' when the data is ready to render.
+export function problem({ error, cloned }) {
+  if (error) return `<p class="error" role="alert">${esc(error)}</p>`;
+  if (!cloned) return '<p class="note">No repository yet. Enter its address in Settings to see your teams.</p>';
+  return '';
+}
+
+// While a command runs every button that starts one is disabled.
+export const busyAttr = (view) => (view.running ? ' disabled' : '');
+
+// The refusal of a command, shown beside the button that started it. where is
+// "<action>:<team>", or "update" for Settings' Update.
+export function actionError(view, where) {
+  const e = view.actionError;
+  return e && e.where === where ? `<span class="error" role="alert">${esc(e.message)}</span>` : '';
+}
+
+export function installedBy(installs) {
+  return new Map((installs || []).map((r) => [r.Team, r]));
+}
diff --git a/desktop/frontend/src/pages/install.js b/desktop/frontend/src/pages/install.js
new file mode 100644
index 0000000..8a9be59
--- /dev/null
+++ b/desktop/frontend/src/pages/install.js
@@ -0,0 +1,46 @@
+import { esc, timeTag, problem, busyAttr, actionError } from './html.js';
+
+// The rows of the install table: one per team with an install record. The
+// records are on this computer, so a catalog error or a missing clone does
+// not hide them; the catalog only flags a team the repository no longer has.
+export function installView(view) {
+  const known = new Set((view.catalog?.teams || []).map((t) => t.name));
+  const records = view.installs || [];
+  if (!records.length) {
+    const blocked = view.error ? problem(view) : '';
+    return { blocked: true, html: blocked + '<p class="note">Nothing is installed yet. Pick a team on the Teams page.</p>' };
+  }
+  const rows = records.map((r) => {
+    const gone = view.cloned && !view.error && !known.has(r.Team);
+    return `<tr data-team="${esc(r.Team)}">
+  <td class="mono">${esc(r.Team)}</td>
+  <td><span class="badge ok">installed</span>${gone ? ' <span class="badge warn">not in the repository</span>' : ''}</td>
+  <td class="num">${r.Files}</td>
+  <td>${timeTag(r.Modified)}</td>
+  <td><div class="row-actions"><button class="btn" data-action="sync" data-team="${esc(r.Team)}"${busyAttr(view)}>Sync</button><button class="btn" data-action="uninstall" data-team="${esc(r.Team)}"${busyAttr(view)}>Uninstall</button>${actionError(view, 'sync:' + r.Team)}${actionError(view, 'uninstall:' + r.Team)}</div></td>
+</tr>`;
+  });
+  return { blocked: false, html: rows.join('\n') };
+}
+
+export const syncArgs = (team) => ['sync', team, '--latest-tag'];
+export const uninstallArgs = (team) => ['uninstall', team];
+
+// onAction(action, team) runs the button's command; action is "sync" or
+// "uninstall".
+export function initInstall(section, onAction) {
+  const body = section.querySelector('tbody');
+  const table = section.querySelector('table');
+  const message = document.createElement('div');
+  table.after(message);
+  body.addEventListener('click', (e) => {
+    const b = e.target.closest('button[data-action]');
+    if (b && !b.disabled) onAction(b.dataset.action, b.dataset.team);
+  });
+  return (view) => {
+    const out = installView(view);
+    table.hidden = out.blocked;
+    message.innerHTML = out.blocked ? out.html : '';
+    if (!out.blocked) body.innerHTML = out.html;
+  };
+}
diff --git a/desktop/frontend/src/pages/settings.js b/desktop/frontend/src/pages/settings.js
new file mode 100644
index 0000000..a19ac06
--- /dev/null
+++ b/desktop/frontend/src/pages/settings.js
@@ -0,0 +1,85 @@
+import * as api from '../api.js';
+
+// SaveSettings refuses with one "KiroHome: ..." or "RepoURL: ..." line per bad
+// field. Anything else is a failure that belongs to no field.
+export function parseFieldErrors(message) {
+  const found = { kiroHome: '', repoUrl: '', other: '' };
+  for (const line of String(message).split('\n')) {
+    if (line.startsWith('KiroHome: ')) found.kiroHome = line.slice('KiroHome: '.length);
+    else if (line.startsWith('RepoURL: ')) found.repoUrl = line.slice('RepoURL: '.length);
+    else if (line.trim()) found.other = line.trim();
+  }
+  return found;
+}
+
+// Update fetches the newest release: for the installed team when there is one,
+// else only the checkout.
+export const updateArgs = (installs) => {
+  const team = (installs || [])[0]?.Team;
+  return team ? ['sync', team, '--latest-tag'] : ['sync', '--latest-tag'];
+};
+
+// onUpdate() runs Update. The returned paint(view) keeps the button disabled
+// while a command runs and shows a refusal beside it.
+export function initSettings(onUpdate) {
+  const updateBtn = document.getElementById('update');
+  const updateErr = document.getElementById('update-error');
+  updateBtn.addEventListener('click', () => onUpdate());
+
+  const home = document.getElementById('kirohome');
+  const repo = document.getElementById('repo');
+  const homeErr = document.getElementById('kirohome-error');
+  const repoErr = document.getElementById('repo-error');
+  const status = document.getElementById('save-status');
+
+  const show = (input, errEl, message) => {
+    errEl.textContent = message;
+    if (message) input.setAttribute('aria-invalid', 'true');
+    else input.removeAttribute('aria-invalid');
+  };
+
+  const envNote = document.getElementById('env-note');
+  let edited = false;
+  home.addEventListener('input', () => { edited = true; });
+
+  // Shows the saved values, or the default Kiro home before anything is saved.
+  // The window opens before the login shell has been read, so until it has
+  // (env.ready) the default is provisional: ask again, and replace it by the
+  // captured KIRO_HOME unless the person has typed in the field.
+  async function load() {
+    try {
+      const st = await api.state();
+      if (!edited) home.value = st.settings.kiroHome || st.env.defaultKiroHome;
+      if (!repo.value) repo.value = st.settings.repoUrl;
+      envNote.textContent = st.env.note || '';
+      if (!st.env.ready) setTimeout(load, 300);
+    } catch (e) {
+      status.textContent = String(e.message || e);
+    }
+  }
+
+  document.getElementById('save').addEventListener('click', async () => {
+    status.textContent = '';
+    show(home, homeErr, '');
+    show(repo, repoErr, '');
+    try {
+      await api.saveSettings({ repoUrl: repo.value.trim(), kiroHome: home.value.trim() });
+      status.textContent = 'Saved on this computer';
+    } catch (e) {
+      const err = parseFieldErrors(e && e.message ? e.message : e);
+      show(home, homeErr, err.kiroHome);
+      show(repo, repoErr, err.repoUrl);
+      status.textContent = err.other;
+      if (err.kiroHome) home.focus();
+      else if (err.repoUrl) repo.focus();
+    }
+  });
+
+  const paint = (view) => {
+    updateBtn.disabled = Boolean(view.running);
+    const e = view.actionError;
+    updateErr.textContent = e && e.where === 'update' ? e.message : '';
+  };
+
+  return { load, paint };
+}
diff --git a/desktop/frontend/src/pages/skills.js b/desktop/frontend/src/pages/skills.js
new file mode 100644
index 0000000..a144957
--- /dev/null
+++ b/desktop/frontend/src/pages/skills.js
@@ -0,0 +1,49 @@
+import { esc, problem } from './html.js';
+
+// Two tables: every skill with its team and source, and the central MCP
+// version pins with the teams whose agents run that server.
+export function skillsView(view) {
+  const blocked = problem(view);
+  if (blocked) return { blocked: true, skills: blocked, mcp: '' };
+
+  const skillRows = [];
+  const users = new Map();
+  for (const t of view.catalog.teams || []) {
+    for (const s of t.skills) {
+      skillRows.push(`<tr><td class="mono">${esc(s.name)}</td><td>${esc(t.name)}</td><td class="desc">${esc(s.source)}</td></tr>`);
+    }
+    for (const a of t.agents) {
+      for (const server of a.servers) {
+        if (!users.has(server)) users.set(server, new Set());
+        users.get(server).add(t.name);
+      }
+    }
+  }
+  const pins = Object.entries(view.catalog.pins || {}).sort(([a], [b]) => a.localeCompare(b));
+  const mcpRows = pins.map(([server, version]) => {
+    const by = [...(users.get(server) || [])].sort().join(', ');
+    return `<tr><td class="mono">${esc(server)}</td><td class="mono">${esc(version)}</td><td>${by ? esc(by) : '<span class="note">no agent yet</span>'}</td></tr>`;
+  });
+  return {
+    blocked: false,
+    skills: skillRows.join('\n') || '<tr><td colspan="3" class="note">No skills yet.</td></tr>',
+    mcp: mcpRows.join('\n') || '<tr><td colspan="3" class="note">No pinned versions.</td></tr>',
+  };
+}
+
+export function initSkills(section) {
+  const tables = [...section.querySelectorAll('table')];
+  const bodies = section.querySelectorAll('tbody');
+  const headings = [...section.querySelectorAll('h2')];
+  const message = document.createElement('div');
+  tables[tables.length - 1].after(message);
+  return (view) => {
+    const out = skillsView(view);
+    for (const el of [...tables, ...headings]) el.hidden = out.blocked;
+    message.innerHTML = out.blocked ? out.skills : '';
+    if (!out.blocked) {
+      bodies[0].innerHTML = out.skills;
+      bodies[1].innerHTML = out.mcp;
+    }
+  };
+}
diff --git a/desktop/frontend/src/pages/teams.js b/desktop/frontend/src/pages/teams.js
new file mode 100644
index 0000000..ce962d8
--- /dev/null
+++ b/desktop/frontend/src/pages/teams.js
@@ -0,0 +1,37 @@
+import { esc, plural, timeTag, problem, installedBy, busyAttr, actionError } from './html.js';
+
+// view = { catalog, installs, error, cloned }
+export function teamsView(view) {
+  const blocked = problem(view);
+  if (blocked) return blocked;
+  const installed = installedBy(view.installs);
+  const teams = view.catalog.teams || [];
+  if (!teams.length) return '<p class="note">The repository has no teams yet.</p>';
+
+  return teams
+    .map((t) => {
+      const rec = installed.get(t.name);
+      const badge = rec
+        ? `<span class="badge ok">installed</span>`
+        : `<span class="badge off">not installed</span>`;
+      const changed = rec ? `<p class="note">Last change ${timeTag(rec.Modified)}</p>` : '';
+      return `<article class="card" data-team="${esc(t.name)}">
+  <div class="card-head"><h3>${esc(t.name)}</h3>${badge}</div>
+  <p class="facts"><span><b>${t.agents.length}</b> ${t.agents.length === 1 ? 'agent' : 'agents'}</span><span><b>${t.skills.length}</b> ${t.skills.length === 1 ? 'skill' : 'skills'}</span><span>${plural(t.prompts, 'prompt', 'prompts')}</span><span>${plural(t.steerings.length, 'steering', 'steerings')}</span></p>
+  ${changed}
+  <div class="actions"><button class="btn primary" data-action="install" data-team="${esc(t.name)}"${busyAttr(view)}>Install</button>${actionError(view, 'install:' + t.name)}</div>
+</article>`;
+    })
+    .join('\n');
+}
+
+// onInstall(team) starts the install flow for the card's team.
+export function initTeams(el, onInstall) {
+  el.addEventListener('click', (e) => {
+    const b = e.target.closest('button[data-action="install"]');
+    if (b && !b.disabled) onInstall(b.dataset.team);
+  });
+  return (view) => {
+    el.innerHTML = teamsView(view);
+  };
+}
diff --git a/desktop/frontend/src/pages/welcome.js b/desktop/frontend/src/pages/welcome.js
new file mode 100644
index 0000000..d1e52e4
--- /dev/null
+++ b/desktop/frontend/src/pages/welcome.js
@@ -0,0 +1,36 @@
+import { esc } from './html.js';
+
+// First launch: until a clone exists the sidebar pages stay hidden and this
+// page asks where the team keeps its repository.
+// view.welcome = { address, error, busy }
+// It also stays while the clone runs: git creates the folder before the first
+// sync has finished.
+export const showWelcome = (view) => !view.cloned || Boolean(view.welcome?.busy);
+
+export function welcomeView(view) {
+  const w = view.welcome || {};
+  const invalid = w.error ? ' aria-invalid="true"' : '';
+  return `<div class="page-head"><div><h1>Set up kirokit</h1><p class="lede">Enter the address of your team's kirokit repository. kirokit copies it to this computer and uses its newest release.</p></div></div>
+<form class="welcome" id="clone-form" novalidate>
+  <div class="field"><label for="clone-address">Repository address</label><input id="clone-address" value="${esc(w.address)}"${invalid} placeholder="https://github.com/your-org/kiro-configs.git" spellcheck="false" autocomplete="off" aria-describedby="clone-hint clone-error"><span class="hint" id="clone-hint">An https, ssh or file address, git@host:path, or an absolute path. If git asks you to sign in, answer in the kirokit tab below.</span><span class="error" id="clone-error" role="alert">${esc(w.error)}</span></div>
+  <div class="actions"><button class="btn primary" type="submit"${w.busy ? ' disabled' : ''}>${w.busy ? 'Cloning…' : 'Clone'}</button></div>
+</form>`;
+}
+
+// initWelcome returns the paint function. The form is redrawn only when its
+// markup changes, so a poll that redraws every page never takes focus or
+// typing away from the field. onClone(address) starts the clone.
+export function initWelcome(section, onClone) {
+  let last = '';
+  section.addEventListener('submit', (e) => {
+    e.preventDefault();
+    onClone(section.querySelector('#clone-address').value);
+  });
+  return (view) => {
+    const html = welcomeView(view);
+    if (html === last) return;
+    last = html;
+    section.innerHTML = html;
+    if (view.welcome?.error) section.querySelector('#clone-address').focus();
+  };
+}
diff --git a/desktop/frontend/src/sidebar.js b/desktop/frontend/src/sidebar.js
new file mode 100644
index 0000000..ed015fe
--- /dev/null
+++ b/desktop/frontend/src/sidebar.js
@@ -0,0 +1,35 @@
+// Sidebar state: which page is showing and whether the sidebar is an icon
+// rail. No DOM here, so node's test runner covers it; main.js renders it.
+
+export const PAGES = ['teams', 'agents', 'install', 'skills', 'settings'];
+
+export function createSidebar({ collapsed = false, page = 'teams' } = {}) {
+  const state = { collapsed, page };
+  const listeners = new Set();
+  const emit = () => listeners.forEach((fn) => fn(state));
+
+  return {
+    get collapsed() { return state.collapsed; },
+    get page() { return state.page; },
+    toggle() {
+      state.collapsed = !state.collapsed;
+      emit();
+    },
+    select(next) {
+      if (!PAGES.includes(next)) return;
+      state.page = next;
+      emit();
+    },
+    // Command-B only: plain B and Control-B belong to the page's inputs.
+    handleKey(e) {
+      if (!e.metaKey || e.ctrlKey || String(e.key).toLowerCase() !== 'b') return false;
+      e.preventDefault();
+      this.toggle();
+      return true;
+    },
+    subscribe(fn) {
+      listeners.add(fn);
+      return () => listeners.delete(fn);
+    },
+  };
+}
diff --git a/desktop/frontend/src/style.css b/desktop/frontend/src/style.css
