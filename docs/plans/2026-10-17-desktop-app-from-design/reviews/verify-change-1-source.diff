new file mode 100644
index 0000000..b2b575b
--- /dev/null
+++ b/desktop/prereq_test.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// fakeBin makes a folder holding executable stubs with the given names.
+func fakeBin(t *testing.T, names ...string) string {
+	t.Helper()
+	dir := t.TempDir()
+	for _, n := range names {
+		if err := os.WriteFile(filepath.Join(dir, n), []byte("#!/bin/sh\n"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func appWithEnv(t *testing.T, vars map[string]string) *App {
+	t.Helper()
+	a := NewAppAt(t.TempDir())
+	a.captureFn = func() EnvCapture { return EnvCapture{Vars: vars} }
+	return a
+}
+
+func byName(t *testing.T, checks []Check, name string) Check {
+	t.Helper()
+	for _, c := range checks {
+		if c.Name == name {
+			return c
+		}
+	}
+	t.Fatalf("no check named %q in %+v", name, checks)
+	return Check{}
+}
+
+func TestPrerequisites_ResolveOnCapturedPath(t *testing.T) {
+	both := fakeBin(t, "sops", "kiro-cli")
+	none := fakeBin(t)
+	key := filepath.Join(t.TempDir(), "keys.txt")
+	if err := os.WriteFile(key, []byte("AGE-SECRET-KEY-1"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got := appWithEnv(t, map[string]string{"PATH": both, "SOPS_AGE_KEY_FILE": key}).Prerequisites("platform-team")
+	for _, name := range []string{"SOPS", "Decryption key", "Kiro CLI"} {
+		if c := byName(t, got, name); !c.Found {
+			t.Errorf("%s not found, want found: %+v", name, c)
+		}
+	}
+
+	got = appWithEnv(t, map[string]string{"PATH": none, "HOME": t.TempDir(), "SOPS_AGE_KEY_FILE": filepath.Join(t.TempDir(), "absent")}).Prerequisites("platform-team")
+	for _, name := range []string{"SOPS", "Decryption key", "Kiro CLI"} {
+		if c := byName(t, got, name); c.Found || c.Detail == "" {
+			t.Errorf("%s = %+v, want missing with a detail to act on", name, c)
+		}
+	}
+}
+
+func TestPrerequisites_KeyLocationOrder(t *testing.T) {
+	home := t.TempDir()
+	xdg := t.TempDir()
+	mac := filepath.Join(home, "Library", "Application Support", "sops", "age", "keys.txt")
+	xdgKey := filepath.Join(xdg, "sops", "age", "keys.txt")
+	for _, p := range []string{mac, xdgKey} {
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte("k"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	vars := map[string]string{"HOME": home, "XDG_CONFIG_HOME": xdg}
+
+	if c := byName(t, appWithEnv(t, vars).Prerequisites("t"), "Decryption key"); c.Detail != xdgKey {
+		t.Errorf("with XDG_CONFIG_HOME, key = %q, want %q", c.Detail, xdgKey)
+	}
+
+	delete(vars, "XDG_CONFIG_HOME")
+	if c := byName(t, appWithEnv(t, vars).Prerequisites("t"), "Decryption key"); c.Detail != mac {
+		t.Errorf("without XDG_CONFIG_HOME, key = %q, want %q", c.Detail, mac)
+	}
+
+	vars["SOPS_AGE_KEY_FILE"] = filepath.Join(home, "missing")
+	if c := byName(t, appWithEnv(t, vars).Prerequisites("t"), "Decryption key"); c.Found {
+		t.Errorf("SOPS_AGE_KEY_FILE points nowhere but the key was found at %q; the variable decides", c.Detail)
+	}
+}
+
+// "Check again" must see a tool installed since the last look.
+func TestPrerequisites_CapturesAfresh(t *testing.T) {
+	bin := t.TempDir()
+	a := appWithEnv(t, map[string]string{"PATH": bin})
+	if byName(t, a.Prerequisites("t"), "SOPS").Found {
+		t.Fatal("sops found before it exists")
+	}
+	if err := os.WriteFile(filepath.Join(bin, "sops"), []byte("#!/bin/sh\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if !byName(t, a.Prerequisites("t"), "SOPS").Found {
+		t.Error("second call did not capture afresh")
+	}
+}
+
+// The default Kiro home follows the captured KIRO_HOME once it arrives; a
+// saved Settings value wins over it.
+func TestKiroHome_CapturedThenSaved(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	a := appWithEnv(t, map[string]string{"KIRO_HOME": "/captured/kiro"})
+
+	if got := a.State().Env.DefaultKiroHome; got != filepath.Join(homeDir(), ".kiro") {
+		t.Errorf("before capture, default = %q, want ~/.kiro", got)
+	}
+	a.refreshEnv()
+	st := a.State()
+	if !st.Env.Ready || st.Env.DefaultKiroHome != "/captured/kiro" {
+		t.Errorf("after capture Env = %+v, want ready with /captured/kiro", st.Env)
+	}
+
+	saved := filepath.Join(homeDir(), "custom-kiro")
+	if err := a.SaveSettings(Settings{KiroHome: saved}); err != nil {
+		t.Fatal(err)
+	}
+	if got := a.kiroHome(); got != saved {
+		t.Errorf("kiroHome = %q, want the saved %q", got, saved)
+	}
+}
diff --git a/desktop/runner.go b/desktop/runner.go
new file mode 100644
index 0000000..1629bfd
--- /dev/null
+++ b/desktop/runner.go
@@ -0,0 +1,189 @@
+package main
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+
+	"github.com/mavogel/kirokit/desktop/terminal"
+)
+
+// errRunning is what Run answers while a command is still going.
+var errRunning = errors.New("kirokit is still running a command")
+
+// runSize is the pseudo-terminal size of a button command; the kirokit tab
+// wraps what it receives to its own width.
+const (
+	runCols = 120
+	runRows = 30
+)
+
+// runHost holds the kirokit tab's one command at a time.
+type runHost struct {
+	mu       sync.Mutex
+	sess     *terminal.Session // nil when no command runs
+	id       int               // the last run id handed out
+	reserved bool              // a multi-step job (the clone) owns the tab between its commands
+}
+
+// runResult is how a command ended: its exit code and the last of its output.
+type runResult struct {
+	Code int
+	Tail string
+}
+
+// tailSize is how much of a command's output is kept for the job that waits
+// on it.
+const tailSize = 4096
+
+// Run starts the bundled kirokit with args in the kirokit tab and returns the
+// run id. The tab prints "▸ kirokit <args>" first and streams the output as
+// term:kirokit; term:kirokit:exit follows when the command ends. A second Run
+// while one runs is refused.
+func (a *App) Run(args []string) (int, error) {
+	cli, err := BundledCLI()
+	if err != nil {
+		return 0, err
+	}
+	return a.runProgram("kirokit", cli, args)
+}
+
+// runProgram runs any program in the kirokit tab under the one-command lock;
+// name is what the header shows. Every run gets the login environment, the
+// bundled kirokit first on PATH, KIROKIT_REPO and the Settings KIRO_HOME.
+func (a *App) runProgram(name, program string, args []string) (int, error) {
+	h := &a.runner
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.sess != nil || h.reserved {
+		return 0, errRunning
+	}
+	id, _, err := a.launchLocked(name, program, args)
+	return id, err
+}
+
+// reserve takes the kirokit tab for a job of several commands, so no button
+// command starts between them. release gives it back.
+func (a *App) reserve() error {
+	h := &a.runner
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.sess != nil || h.reserved {
+		return errRunning
+	}
+	h.reserved = true
+	return nil
+}
+
+func (a *App) release() {
+	h := &a.runner
+	h.mu.Lock()
+	h.reserved = false
+	h.mu.Unlock()
+}
+
+// runStep runs one command of a reserved job and waits for it to end.
+func (a *App) runStep(name, program string, args []string) (runResult, error) {
+	h := &a.runner
+	h.mu.Lock()
+	_, done, err := a.launchLocked(name, program, args)
+	h.mu.Unlock()
+	if err != nil {
+		return runResult{}, err
+	}
+	return <-done, nil
+}
+
+// launchLocked starts a command with h.mu held and returns its run id and the
+// channel its result arrives on.
+func (a *App) launchLocked(name, program string, args []string) (int, <-chan runResult, error) {
+	h := &a.runner
+	if h.sess != nil {
+		return 0, nil, errRunning
+	}
+
+	cmd := exec.Command(program, args...)
+	cli, _ := BundledCLI() //nolint:errcheck // a missing bundled CLI only leaves PATH as it was
+	cmd.Env = a.terminalEnv(cli, nil)
+	cmd.Dir = a.repoDir()
+	if _, err := os.Stat(cmd.Dir); err != nil {
+		cmd.Dir = homeDir()
+	}
+	sess, err := terminal.Start(cmd, runCols, runRows)
+	if err != nil {
+		return 0, nil, err
+	}
+	h.id++
+	id := h.id
+	h.sess = sess
+
+	header := "▸ " + strings.Join(append([]string{name}, args...), " ") + "\r\n"
+	a.emit("term:kirokit", chunkOf(id, []byte(header)))
+	done := make(chan runResult, 1)
+	// A kirokit sync can bring a new team or pin to the checkout.
+	isSync := name == "kirokit" && len(args) > 0 && args[0] == "sync"
+	go a.finishRun(id, sess, isSync, done)
+	return id, done, nil
+}
+
+// finishRun streams a command's output and, once it ends, frees the lock,
+// renders the catalog again after a sync, reads the install records and
+// announces the exit.
+func (a *App) finishRun(id int, sess *terminal.Session, isSync bool, done chan<- runResult) {
+	var tail []byte
+	stream(sess, func(b []byte) {
+		tail = append(tail, b...)
+		if len(tail) > tailSize {
+			tail = tail[len(tail)-tailSize:]
+		}
+		a.emit("term:kirokit", chunkOf(id, b))
+	})
+	code, _ := sess.Wait() //nolint:errcheck // a wait error is shown as the exit code
+	_ = sess.Close()       //nolint:errcheck // the process has ended
+
+	h := &a.runner
+	h.mu.Lock()
+	h.sess = nil
+	h.mu.Unlock()
+
+	if isSync {
+		a.refreshCatalog()
+	}
+
+	// The command may have installed or removed a team; show it now rather
+	// than at the next poll.
+	a.mu.Lock()
+	p := a.poller
+	a.mu.Unlock()
+	if p != nil {
+		p.Check()
+	}
+	a.emit("term:kirokit:exit", termExit{ID: id, Code: code})
+	done <- runResult{Code: code, Tail: string(tail)}
+}
+
+// RunWrite sends keystrokes to the running command, such as a git sign-in
+// answer. Input for any other run id is dropped.
+func (a *App) RunWrite(id int, data string) {
+	h := &a.runner
+	h.mu.Lock()
+	sess := h.sess
+	current := h.id
+	h.mu.Unlock()
+	if sess == nil || id != current {
+		return
+	}
+	_, _ = sess.Write([]byte(data)) //nolint:errcheck // a command that just ended reports through its exit
+}
+
+// close ends the running command at app shutdown.
+func (h *runHost) close() {
+	h.mu.Lock()
+	sess := h.sess
+	h.mu.Unlock()
+	if sess != nil {
+		_ = sess.Close() //nolint:errcheck // shutting down
+	}
+}
diff --git a/desktop/runner_test.go b/desktop/runner_test.go
new file mode 100644
index 0000000..fbfc70a
--- /dev/null
+++ b/desktop/runner_test.go
@@ -0,0 +1,234 @@
+package main
+
+import (
+	"encoding/base64"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/mavogel/kirokit/internal/install"
+)
+
+// eventLog records every event the app emits, in order.
+type eventLog struct {
+	mu     sync.Mutex
+	events []string
+	out    strings.Builder // term:kirokit output
+	exits  []termExit
+	last   []install.Record
+	clone  *cloneResult // the last clone:done
+}
+
+func (l *eventLog) clearClone() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.clone = nil
+}
+
+func (l *eventLog) emit(event string, data any) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.events = append(l.events, event)
+	switch event {
+	case "clone:done":
+		res := data.(cloneResult)
+		l.clone = &res
+	case "term:kirokit":
+		raw, _ := base64.StdEncoding.DecodeString(data.(termChunk).B64)
+		l.out.Write(raw)
+	case "term:kirokit:exit":
+		l.exits = append(l.exits, data.(termExit))
+	case "installs:changed":
+		l.last, _ = data.([]install.Record)
+	}
+}
+
+func (l *eventLog) output() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.out.String()
+}
+
+func (l *eventLog) wait(t *testing.T, what string, ok func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(20 * time.Second)
+	for time.Now().Before(deadline) {
+		if ok() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %s; output %q", what, l.output())
+}
+
+func (l *eventLog) waitOutput(t *testing.T, want string) {
+	t.Helper()
+	l.wait(t, "output "+want, func() bool { return strings.Contains(l.output(), want) })
+}
+
+func (l *eventLog) waitExit(t *testing.T) termExit {
+	t.Helper()
+	l.wait(t, "the exit event", func() bool {
+		l.mu.Lock()
+		defer l.mu.Unlock()
+		return len(l.exits) > 0
+	})
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.exits[len(l.exits)-1]
+}
+
+func runnerApp(t *testing.T, script string) (*App, *eventLog, string) {
+	t.Helper()
+	a, _, home, _ := shellApp(t, "/bin/sh")
+	cli := writeScript(t, t.TempDir(), "kirokit", script)
+	t.Setenv("KIROKIT_DESKTOP_CLI", cli)
+	if err := a.SaveSettings(Settings{KiroHome: filepath.Join(home, "kh")}); err != nil {
+		t.Fatal(err)
+	}
+	log := &eventLog{}
+	a.emitter = log.emit
+	return a, log, filepath.Join(home, "kh")
+}
+
+func TestRunner_HeaderThenOutputThenExit(t *testing.T) {
+	a, log, kiroHome := runnerApp(t, `echo "args=$*"; echo "repo=$KIROKIT_REPO home=$KIRO_HOME"; exit 4`)
+
+	id, err := a.Run([]string{"install", "data-team"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	exit := log.waitExit(t)
+
+	if exit.ID != id || exit.Code != 4 {
+		t.Errorf("exit = %+v, want id %d code 4", exit, id)
+	}
+	out := log.output()
+	if !strings.HasPrefix(out, "▸ kirokit install data-team\r\n") {
+		t.Errorf("output must start with the header, got %q", out)
+	}
+	for _, want := range []string{
+		"args=install data-team",
+		"repo=" + filepath.Join(a.dataDir, "repo") + " home=" + kiroHome,
+	} {
+		if !strings.Contains(out, want) {
+			t.Errorf("output lacks %q:\n%q", want, out)
+		}
+	}
+}
+
+func TestRunner_RefusesASecondCommandWhileOneRuns(t *testing.T) {
+	a, log, _ := runnerApp(t, `echo ready; read line; echo "got $line"`)
+
+	id, err := a.Run([]string{"sync"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	log.waitOutput(t, "ready")
+
+	if _, err := a.Run([]string{"sync"}); err == nil || err.Error() != "kirokit is still running a command" {
+		t.Fatalf("second Run error = %v, want \"kirokit is still running a command\"", err)
+	}
+
+	// RunWrite reaches the running command's input, and the lock is released after the exit.
+	a.RunWrite(id, "hello\r")
+	log.waitOutput(t, "got hello")
+	log.waitExit(t)
+	if _, err := a.Run([]string{"version"}); err != nil {
+		t.Fatalf("Run after the first ended: %v", err)
+	}
+}
+
+func TestRunner_WriteForAnotherRunIsIgnored(t *testing.T) {
+	a, log, _ := runnerApp(t, `echo ready; read line; echo "got [$line]"`)
+
+	id, err := a.Run(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	log.waitOutput(t, "ready")
+	a.RunWrite(id+1, "stale\r")
+	a.RunWrite(id, "right\r")
+
+	log.waitOutput(t, "got [right]")
+}
+
+func TestRunner_MissingCLINamesTheOverride(t *testing.T) {
+	a, _, _ := runnerApp(t, "")
+	t.Setenv("KIROKIT_DESKTOP_CLI", "")
+	t.Chdir(t.TempDir())
+
+	_, err := a.Run([]string{"version"})
+	if err == nil || !strings.Contains(err.Error(), "KIROKIT_DESKTOP_CLI") {
+		t.Fatalf("Run error = %v, want a message naming KIROKIT_DESKTOP_CLI", err)
+	}
+}
+
+func TestRunner_AnyProgramShowsItsOwnName(t *testing.T) {
+	a, log, _ := runnerApp(t, "")
+	prog := writeScript(t, t.TempDir(), "git", `echo from-git`)
+
+	if _, err := a.runProgram("git", prog, []string{"clone", "x"}); err != nil {
+		t.Fatal(err)
+	}
+	log.waitExit(t)
+	if out := log.output(); !strings.HasPrefix(out, "▸ git clone x\r\n") || !strings.Contains(out, "from-git") {
+		t.Errorf("output = %q, want the git header then its output", out)
+	}
+}
+
+// A sync can bring a new team or pin, so the cached catalog is rendered again
+// when it ends; any other command leaves the cache alone.
+func TestRunner_SyncEndRendersTheCatalogAgain(t *testing.T) {
+	a, log, _ := runnerApp(t, `d="$KIROKIT_REPO/teams/new-$1"; mkdir -p "$d"; printf 'team: new-%s\nglobalSteerings: []\n' "$1" > "$d/manifest.yaml"`)
+	repo := a.repoDir()
+	write(t, filepath.Join(repo, "teams", "t1", "manifest.yaml"), "team: t1\nglobalSteerings: []\n")
+	write(t, filepath.Join(repo, "env", "mcp-versions.yaml"), "x-mcp: \"1\"\n")
+	if cat, err := a.Catalog(); err != nil || len(cat.Teams) != 1 {
+		t.Fatalf("first Catalog = %+v, %v", cat, err)
+	}
+
+	if _, err := a.Run([]string{"install"}); err != nil {
+		t.Fatal(err)
+	}
+	log.waitExit(t)
+	if cat, _ := a.Catalog(); len(cat.Teams) != 1 {
+		t.Fatalf("an install must not render again, got %d teams", len(cat.Teams))
+	}
+
+	if _, err := a.Run([]string{"sync", "--latest-tag"}); err != nil {
+		t.Fatal(err)
+	}
+	log.wait(t, "the second exit", func() bool {
+		log.mu.Lock()
+		defer log.mu.Unlock()
+		return len(log.exits) == 2
+	})
+	cat, err := a.Catalog()
+	if err != nil || len(cat.Teams) != 3 || cat.Teams[1].Name != "new-sync" {
+		t.Fatalf("Catalog after the sync = %+v, %v; want t1, new-install and new-sync", cat, err)
+	}
+}
+
+// When a command ends the install records are read at once, so a team the
+// command installed shows without waiting for the next poll.
+func TestRunner_EndChecksTheInstallRecords(t *testing.T) {
+	fixture := t.TempDir()
+	installFixture(t, fixture)
+	a, log, _ := runnerApp(t, `cp -R "`+fixture+`/." "$KIRO_HOME"`)
+	a.poller = newInstallPoller(a.kiroHome, a.emit, time.Hour)
+	t.Cleanup(a.poller.Stop)
+
+	if _, err := a.Run([]string{"install", "t1"}); err != nil {
+		t.Fatal(err)
+	}
+	log.waitExit(t)
+
+	log.wait(t, "installs:changed", func() bool {
+		log.mu.Lock()
+		defer log.mu.Unlock()
+		return len(log.last) == 1 && log.last[0].Team == "t1"
+	})
+}
diff --git a/desktop/settings.go b/desktop/settings.go
new file mode 100644
index 0000000..8639b22
--- /dev/null
+++ b/desktop/settings.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+// Settings are the two values the person chooses; settings.json beside repo/
+// holds them. An empty RepoURL means no repository is configured yet.
+type Settings struct {
+	RepoURL  string `json:"repoUrl"`
+	KiroHome string `json:"kiroHome"`
+}
+
+// repoURLPattern accepts https://, ssh:// and file:// addresses, scp-style
+// git@host:path and absolute paths. Every alternative starts with a letter or
+// "/", so an address can never be read by git as an option.
+var repoURLPattern = regexp.MustCompile(`^(?:(?:https|ssh|file)://\S+|git@\S+:\S+|/\S+)$`)
+
+func (a *App) settingsPath() string { return filepath.Join(a.dataDir, "settings.json") }
+
+func (a *App) loadSettings() Settings {
+	var s Settings
+	data, err := os.ReadFile(a.settingsPath())
+	if err != nil {
+		return Settings{}
+	}
+	if json.Unmarshal(data, &s) != nil {
+		return Settings{}
+	}
+	return s
+}
+
+// SaveSettings validates both values and stores them. A refusal names each
+// bad field on its own line as "KiroHome: ..." or "RepoURL: ...", and saves
+// nothing.
+func (a *App) SaveSettings(s Settings) error {
+	s.RepoURL = strings.TrimSpace(s.RepoURL)
+	s.KiroHome = strings.TrimSpace(s.KiroHome)
+
+	var problems []error
+	if msg := checkKiroHome(s.KiroHome); msg != "" {
+		problems = append(problems, errors.New("KiroHome: "+msg))
+	} else {
+		s.KiroHome = filepath.Clean(s.KiroHome)
+	}
+	if s.RepoURL != "" && !repoURLPattern.MatchString(s.RepoURL) {
+		problems = append(problems, errors.New("RepoURL: "+repoURLMessage))
+	}
+	if len(problems) > 0 {
+		return errors.Join(problems...)
+	}
+	return a.writeSettings(s)
+}
+
+// repoURLMessage is shown beside an address field that holds a bad address.
+const repoURLMessage = "Use an https, ssh or file address, git@host:path, or an absolute path"
+
+// writeSettings stores s as it is, replacing settings.json atomically.
+func (a *App) writeSettings(s Settings) error {
+	data, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(a.dataDir, 0o755); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(a.dataDir, "settings-*.json")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name()) //nolint:errcheck // gone after a successful rename
+	if err := tmp.Chmod(0o600); err != nil {
+		tmp.Close() //nolint:errcheck // the chmod error is the one to report
+		return err
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close() //nolint:errcheck // the write error is the one to report
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmp.Name(), a.settingsPath())
+}
+
+// defaultKiroHome is the captured KIRO_HOME, else ~/.kiro.
+func defaultKiroHome(env EnvCapture, ready bool) string {
+	if ready {
+		if p := env.Getenv("KIRO_HOME"); p != "" {
+			return p
+		}
+	}
+	return filepath.Join(homeDir(), ".kiro")
+}
+
+// kiroHome is the Kiro home folder commands act on: the saved Settings value,
+// which wins over the shell's own KIRO_HOME, else the default.
+func (a *App) kiroHome() string {
+	if p := a.loadSettings().KiroHome; p != "" {
+		return p
+	}
+	a.mu.Lock()
+	env, ready := a.env, a.envReady
+	a.mu.Unlock()
+	return defaultKiroHome(env, ready)
+}
+
+func checkKiroHome(p string) string {
+	if !filepath.IsAbs(p) {
+		return "Enter an absolute folder, such as " + filepath.Join(homeDir(), ".kiro")
+	}
+	clean := filepath.Clean(p)
+	if clean == "/" || clean == filepath.Clean(homeDir()) {
+		return "Choose a folder inside your home folder, not the home folder itself"
+	}
+	return ""
+}
diff --git a/desktop/settings_test.go b/desktop/settings_test.go
new file mode 100644
index 0000000..defd738
--- /dev/null
+++ b/desktop/settings_test.go
@@ -0,0 +1,105 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func newTestApp(t *testing.T) (*App, string, string) {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	data := filepath.Join(t.TempDir(), "kirokit-desktop")
+	return NewAppAt(data), data, home
+}
+
+// Saved values must survive a restart, which is a new App on the same folder.
+func TestSaveSettings_SurvivesNewApp(t *testing.T) {
+	app, data, home := newTestApp(t)
+	want := Settings{RepoURL: "git@github.com:acme/kiro-configs.git", KiroHome: filepath.Join(home, "kiro")}
+
+	if err := app.SaveSettings(want); err != nil {
+		t.Fatalf("SaveSettings: %v", err)
+	}
+
+	if got := NewAppAt(data).State().Settings; got != want {
+		t.Errorf("after restart Settings = %+v, want %+v", got, want)
+	}
+}
+
+// A refused Kiro home must name its field and save nothing, so a bad value
+// never replaces a good one.
+func TestSaveSettings_RefusesKiroHome(t *testing.T) {
+	app, data, home := newTestApp(t)
+	good := Settings{KiroHome: filepath.Join(home, "kiro")}
+	if err := app.SaveSettings(good); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, bad := range []string{"", "kiro", "~/.kiro", "/", home, home + "/", "/./"} {
+		err := app.SaveSettings(Settings{KiroHome: bad})
+		if err == nil || !strings.HasPrefix(err.Error(), "KiroHome: ") {
+			t.Errorf("KiroHome %q: err = %v, want a KiroHome: message", bad, err)
+		}
+	}
+	if got := NewAppAt(data).State().Settings; got != good {
+		t.Errorf("Settings after refusals = %+v, want unchanged %+v", got, good)
+	}
+}
+
+func TestSaveSettings_RepoURL(t *testing.T) {
+	app, _, home := newTestApp(t)
+	kiro := filepath.Join(home, "kiro")
+
+	for _, ok := range []string{
+		"https://github.com/acme/kiro-configs.git",
+		"ssh://git@example.com/acme/configs.git",
+		"git@github.com:acme/kiro-configs.git",
+		"file:///tmp/origin",
+		"/tmp/origin",
+		"", // not configured yet
+	} {
+		if err := app.SaveSettings(Settings{RepoURL: ok, KiroHome: kiro}); err != nil {
+			t.Errorf("RepoURL %q refused: %v", ok, err)
+		}
+	}
+	for _, bad := range []string{
+		"-oProxyCommand=x", "--upload-pack=x", "http://example.com/r.git", "ftp://example.com/r",
+		"relative/path", "https://", "https://exa mple.com/r", "git@", "/tmp/a b",
+	} {
+		err := app.SaveSettings(Settings{RepoURL: bad, KiroHome: kiro})
+		if err == nil || !strings.HasPrefix(err.Error(), "RepoURL: ") {
+			t.Errorf("RepoURL %q: err = %v, want a RepoURL: message", bad, err)
+		}
+	}
+}
+
+// Both fields are reported together so the page can mark each one.
+func TestSaveSettings_ReportsBothFields(t *testing.T) {
+	app, _, _ := newTestApp(t)
+
+	err := app.SaveSettings(Settings{RepoURL: "-x", KiroHome: "/"})
+
+	if err == nil {
+		t.Fatal("want an error")
+	}
+	if lines := strings.Split(err.Error(), "\n"); len(lines) != 2 {
+		t.Errorf("errors = %q, want one line per field", lines)
+	}
+}
+
+func TestSaveSettings_WritesPrivateFile(t *testing.T) {
+	app, data, home := newTestApp(t)
+	if err := app.SaveSettings(Settings{KiroHome: filepath.Join(home, "kiro")}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(filepath.Join(data, "settings.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Errorf("settings.json mode = %v, want 0600", info.Mode().Perm())
+	}
+}
diff --git a/desktop/shell.go b/desktop/shell.go
new file mode 100644
index 0000000..8aced61
--- /dev/null
+++ b/desktop/shell.go
@@ -0,0 +1,298 @@
+package main
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"sync"
+
+	"github.com/mavogel/kirokit/desktop/terminal"
+)
+
+// termChunk is the payload of term:shell and term:kirokit: terminal bytes as
+// base64, so no escape sequence is mangled in JSON. ID is the run id of a
+// kirokit-tab command and absent for the shell.
+type termChunk struct {
+	ID  int    `json:"id,omitempty"`
+	B64 string `json:"b64"`
+}
+
+// termExit is the payload of term:kirokit:exit.
+type termExit struct {
+	ID   int `json:"id"`
+	Code int `json:"code"`
+}
+
+// BundledCLI returns the kirokit binary the app's terminals use.
+// 1. $KIROKIT_DESKTOP_CLI if set. 2. <executable>/../../Resources/bin/kirokit.
+// 3. desktop/build/dev-bin/kirokit, which `task desktop:dev` builds.
+func BundledCLI() (string, error) {
+	exe, _ := os.Executable() //nolint:errcheck // an empty path just skips the bundle lookup
+	wd, _ := os.Getwd()       //nolint:errcheck // an empty path just skips the dev lookup
+	return resolveCLI(os.Getenv("KIROKIT_DESKTOP_CLI"), exe, wd)
+}
+
+func resolveCLI(override, exe, wd string) (string, error) {
+	if override != "" {
+		return override, nil
+	}
+	var candidates []string
+	if exe != "" {
+		macOS := filepath.Dir(exe)
+		candidates = append(candidates,
+			filepath.Join(macOS, "..", "Resources", "bin", "kirokit"),
+			// wails dev runs desktop/build/bin/kirokit.
+			filepath.Join(macOS, "..", "dev-bin", "kirokit"))
+	}
+	if wd != "" {
+		candidates = append(candidates, filepath.Join(wd, "build", "dev-bin", "kirokit"))
+	}
+	for _, c := range candidates {
+		if info, err := os.Stat(c); err == nil && !info.IsDir() {
+			return filepath.Clean(c), nil
+		}
+	}
+	return "", errors.New("kirokit's command-line tool was not found. Set KIROKIT_DESKTOP_CLI to the path of a kirokit binary, or start the app from kirokit.app")
+}
+
+// shellPath is the person's login shell: the captured SHELL, else the app's
+// own, else zsh.
+func (a *App) shellPath() string {
+	a.mu.Lock()
+	env, ready := a.env, a.envReady
+	a.mu.Unlock()
+	if ready {
+		if s := env.Getenv("SHELL"); s != "" {
+			return s
+		}
+	}
+	if s := os.Getenv("SHELL"); s != "" {
+		return s
+	}
+	return "/bin/zsh"
+}
+
+func isZsh(shell string) bool { return filepath.Base(shell) == "zsh" }
+
+// shellNote tells Settings when the bundled CLI cannot be guaranteed first.
+func shellNote(shell string) string {
+	if isZsh(shell) {
+		return ""
+	}
+	return "Your shell is " + filepath.Base(shell) + ", so the bundled kirokit may not come first on its PATH if your startup files change it."
+}
+
+// loginEnv is the captured login environment, read now when no one has yet.
+func (a *App) loginEnv() EnvCapture {
+	a.mu.Lock()
+	env, ready := a.env, a.envReady
+	a.mu.Unlock()
+	if ready {
+		return env
+	}
+	return a.refreshEnv()
+}
+
+// terminalEnv is the environment of every terminal the app starts: the login
+// environment, a PATH with the bundled CLI's folder first, and the app's own
+// repository and Kiro home. extra entries override the rest.
+func (a *App) terminalEnv(cli string, extra map[string]string) []string {
+	vars := map[string]string{}
+	for k, v := range a.loginEnv().Vars {
+		vars[k] = v
+	}
+	vars["TERM"] = "xterm-256color"
+	vars["COLORTERM"] = "truecolor"
+	vars["KIROKIT_REPO"] = a.repoDir()
+	vars["KIRO_HOME"] = a.kiroHome()
+	if cli != "" {
+		vars["PATH"] = filepath.Dir(cli) + ":" + vars["PATH"]
+	}
+	for k, v := range extra {
+		vars[k] = v
+	}
+	env := make([]string, 0, len(vars))
+	for k, v := range vars {
+		env = append(env, k+"="+v)
+	}
+	sort.Strings(env)
+	return env
+}
+
+// wrapperFiles are the zsh startup files of the ZDOTDIR wrapper. Each sources
+// the person's own file of the same name, then puts ZDOTDIR back so zsh finds
+// the next wrapper file. The last-read files re-assert the app's settings, so
+// the person's own startup files cannot override them.
+var wrapperFiles = map[string]string{
+	".zshenv":   wrapperSource(".zshenv", ""),
+	".zprofile": wrapperSource(".zprofile", ""),
+	".zshrc":    wrapperSource(".zshrc", wrapperSettings),
+	".zlogin":   wrapperSource(".zlogin", wrapperSettings+wrapperRestore),
+}
+
+const wrapperSettings = `if [[ -n "$KIROKIT_BIN" ]]; then path=("$KIROKIT_BIN" ${path:#$KIROKIT_BIN}); fi
+export KIROKIT_REPO="$KIROKIT_APP_REPO" KIRO_HOME="$KIROKIT_APP_KIRO_HOME"
+`
+
+// wrapperRestore leaves the finished shell, and any shell it starts, with the
+// person's own ZDOTDIR.
+const wrapperRestore = `if [[ -n "${KIROKIT_USER_ZDOTDIR+x}" ]]; then export ZDOTDIR="$KIROKIT_USER_ZDOTDIR"; else unset ZDOTDIR; fi
+`
+
+func wrapperSource(name, after string) string {
+	return `# Written by kirokit: sources your own ` + name + `, then keeps kirokit's settings last.
+__kirokit_wrapper="$ZDOTDIR"
+ZDOTDIR="${KIROKIT_USER_ZDOTDIR:-$HOME}"
+[[ -r "$ZDOTDIR/` + name + `" ]] && source "$ZDOTDIR/` + name + `"
+ZDOTDIR="$__kirokit_wrapper"
+unset __kirokit_wrapper
+` + after
+}
+
+// writeWrapper writes the ZDOTDIR wrapper into dir and returns it.
+func writeWrapper(dir string) (string, error) {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", err
+	}
+	for name, body := range wrapperFiles {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o644); err != nil {
+			return "", err
+		}
+	}
+	return dir, nil
+}
+
+// shellHost is the zsh tab's one long-lived shell. It starts when the tab is
+// first sized, and survives closing the dock.
+type shellHost struct {
+	mu         sync.Mutex
+	sess       *terminal.Session
+	cols, rows uint16
+	ended      bool // the shell exited; only typing starts a new one
+}
+
+// shellCommand builds `$SHELL -il` for the zsh tab. For zsh it starts through
+// the ZDOTDIR wrapper; for any other shell the settings are only in the
+// start environment.
+func (a *App) shellCommand() (*exec.Cmd, error) {
+	shell := a.shellPath()
+	cli, cliErr := BundledCLI()
+	extra := map[string]string{}
+	if cliErr == nil {
+		extra["KIROKIT_BIN"] = filepath.Dir(cli)
+	}
+	if isZsh(shell) {
+		wrapper, err := writeWrapper(filepath.Join(a.dataDir, "zdotdir"))
+		if err != nil {
+			return nil, err
+		}
+		extra["ZDOTDIR"] = wrapper
+		extra["KIROKIT_APP_REPO"] = a.repoDir()
+		extra["KIROKIT_APP_KIRO_HOME"] = a.kiroHome()
+		if z, ok := a.loginEnv().Vars["ZDOTDIR"]; ok {
+			extra["KIROKIT_USER_ZDOTDIR"] = z
+		}
+	}
+	cmd := exec.Command(shell, "-il")
+	cmd.Env = a.terminalEnv(cli, extra)
+	cmd.Dir = a.repoDir()
+	if _, err := os.Stat(cmd.Dir); err != nil {
+		cmd.Dir = homeDir()
+	}
+	return cmd, nil
+}
+
+// ShellWrite sends keystrokes typed in the zsh tab to the shell.
+func (a *App) ShellWrite(data string) {
+	h := &a.shell
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.sess == nil {
+		if h.cols == 0 || !a.startShellLocked() {
+			return
+		}
+	}
+	_, _ = h.sess.Write([]byte(data)) //nolint:errcheck // a shell that just ended reports through its exit
+}
+
+// ShellResize tells the shell the size of the zsh tab, and starts it the
+// first time the tab is sized.
+func (a *App) ShellResize(cols, rows int) {
+	if cols < 1 || rows < 1 || cols > 1000 || rows > 1000 {
+		return
+	}
+	h := &a.shell
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.cols, h.rows = uint16(cols), uint16(rows)
+	if h.sess != nil {
+		_ = h.sess.Resize(h.cols, h.rows) //nolint:errcheck // the next resize retries
+		return
+	}
+	if !h.ended {
+		a.startShellLocked()
+	}
+}
+
+// startShellLocked starts the shell at the stored size and streams it. It
+// reports whether a shell now runs; h.mu is held.
+func (a *App) startShellLocked() bool {
+	h := &a.shell
+	cmd, err := a.shellCommand()
+	var sess *terminal.Session
+	if err == nil {
+		sess, err = terminal.Start(cmd, h.cols, h.rows)
+	}
+	if err != nil {
+		a.emit("term:shell", chunkOf(0, []byte("\x1b[31mcould not start your shell: "+err.Error()+"\x1b[0m\r\n")))
+		h.ended = true
+		return false
+	}
+	h.sess, h.ended = sess, false
+	go func() {
+		stream(sess, func(b []byte) { a.emit("term:shell", chunkOf(0, b)) })
+		code, _ := sess.Wait() //nolint:errcheck // a wait error is shown as the exit code
+		_ = sess.Close()       //nolint:errcheck // the process has ended
+		h.mu.Lock()
+		if h.sess == sess {
+			h.sess, h.ended = nil, true
+		}
+		h.mu.Unlock()
+		a.emit("term:shell", chunkOf(0, []byte(fmt.Sprintf("\r\n\x1b[2mshell ended (exit %d). Type to start a new one.\x1b[0m\r\n", code))))
+	}()
+	return true
+}
+
+// close ends the shell at app shutdown.
+func (h *shellHost) close() {
+	h.mu.Lock()
+	sess := h.sess
+	h.sess = nil
+	h.ended = true
+	h.mu.Unlock()
+	if sess != nil {
+		_ = sess.Close() //nolint:errcheck // shutting down
+	}
+}
+
+func chunkOf(id int, b []byte) termChunk {
+	return termChunk{ID: id, B64: base64.StdEncoding.EncodeToString(b)}
+}
+
+// stream copies a session's output to send until the terminal closes.
+func stream(s *terminal.Session, send func([]byte)) {
+	buf := make([]byte, 8192)
+	for {
+		n, err := s.Read(buf)
+		if n > 0 {
+			send(append([]byte(nil), buf[:n]...))
+		}
+		if err != nil {
+			return
+		}
+	}
+}
diff --git a/desktop/shell_test.go b/desktop/shell_test.go
new file mode 100644
index 0000000..61a5f59
--- /dev/null
+++ b/desktop/shell_test.go
@@ -0,0 +1,173 @@
+package main
+
+import (
+	"context"
+	"encoding/base64"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// recorder collects the term:* output the app emits.
+type recorder struct {
+	mu  sync.Mutex
+	buf strings.Builder
+}
+
+func (r *recorder) emit(event string, data any) {
+	if event != "term:shell" {
+		return
+	}
+	chunk := data.(termChunk)
+	raw, _ := base64.StdEncoding.DecodeString(chunk.B64)
+	r.mu.Lock()
+	r.buf.Write(raw)
+	r.mu.Unlock()
+}
+
+func (r *recorder) String() string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.buf.String()
+}
+
+func (r *recorder) waitFor(t *testing.T, want string) string {
+	t.Helper()
+	deadline := time.Now().Add(20 * time.Second)
+	for time.Now().Before(deadline) {
+		if s := r.String(); strings.Contains(s, want) {
+			return s
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Fatalf("output never contained %q; got %q", want, r.String())
+	return ""
+}
+
+// writeScript writes an executable script at dir/name.
+func writeScript(t *testing.T, dir, name, body string) string {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte("#!/bin/sh\n"+body+"\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// shellApp returns an App whose data folder, home folder and bundled CLI are
+// temporary, with a login environment that points HOME at the temp home.
+func shellApp(t *testing.T, shell string) (*App, *recorder, string, string) {
+	t.Helper()
+	home := t.TempDir()
+	bundled := filepath.Join(t.TempDir(), "bundle")
+	cli := writeScript(t, bundled, "kirokit", `echo bundled-kirokit`)
+	t.Setenv("KIROKIT_DESKTOP_CLI", cli)
+
+	a := NewAppAt(filepath.Join(t.TempDir(), "data"))
+	a.captureFn = func() EnvCapture {
+		return EnvCapture{Vars: map[string]string{
+			"HOME": home, "USER": "tester", "SHELL": shell,
+			"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "KIRO_HOME": "/captured/wrong",
+		}}
+	}
+	rec := &recorder{}
+	a.emitter = rec.emit
+	t.Cleanup(func() { a.shutdown(context.Background()) })
+	return a, rec, home, cli
+}
+
+func TestShell_BundledKirokitComesFirstAndSettingsWin(t *testing.T) {
+	zsh, err := exec.LookPath("zsh")
+	if err != nil {
+		t.Skip("zsh is not installed")
+	}
+	a, rec, home, cli := shellApp(t, zsh)
+
+	// The person's own startup files put another kirokit first and set KIRO_HOME.
+	other := filepath.Join(t.TempDir(), "older")
+	writeScript(t, other, "kirokit", `echo older-kirokit`)
+	rc := "export PATH=" + other + ":$PATH\nexport KIRO_HOME=/from-zshrc\nPROMPT='%# '\n"
+	if err := os.WriteFile(filepath.Join(home, ".zshrc"), []byte(rc), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.SaveSettings(Settings{KiroHome: filepath.Join(home, "kh")}); err != nil {
+		t.Fatal(err)
+	}
+
+	wantVars := "[" + filepath.Join(a.dataDir, "repo") + "] [" + filepath.Join(home, "kh") + "]"
+
+	a.ShellResize(100, 30)
+	a.ShellWrite("command -v kirokit; echo \"[$KIROKIT_REPO] [$KIRO_HOME]\"\r")
+
+	out := rec.waitFor(t, wantVars)
+	if !strings.Contains(out, cli+"\r\n") {
