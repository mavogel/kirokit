diff --git a/desktop/frontend/src/api.js b/desktop/frontend/src/api.js
new file mode 100644
index 0000000..ee20173
--- /dev/null
+++ b/desktop/frontend/src/api.js
@@ -0,0 +1,57 @@
+// The only module that reaches Go. Wails injects window.go and window.runtime
+// at run time, so nothing generated is committed and `npm run build` works
+// before any Wails run. Pages import this file and nothing else from Go.
+
+const app = () => {
+  const bound = window.go && window.go.main && window.go.main.App;
+  if (!bound) throw new Error('kirokit is not running inside its window');
+  return bound;
+};
+
+export const state = () => app().State();
+
+export const saveSettings = (settings) => app().SaveSettings(settings);
+
+export const catalog = () => app().Catalog();
+
+export const installs = () => app().Installs();
+
+// Captures the login environment afresh each time it is called.
+export const prerequisites = (team) => app().Prerequisites(team);
+
+// Runs kirokit with args in the kirokit tab and resolves to the run id.
+export const run = (args) => app().Run(args);
+
+// Clones the repository at address and syncs to its newest release; resolves
+// when the clone starts, rejects with the reason an address was refused.
+// clone:done reports the end.
+export const clone = (address) => app().Clone(address);
+
+// Wails runs every bound call on its own goroutine, so keystrokes sent without
+// waiting can reach a terminal out of order. Each terminal sends its input
+// through one line: a call starts after the one before it has ended, whether
+// that succeeded or not.
+function line() {
+  let tail = Promise.resolve();
+  return (call) => {
+    const result = tail.then(() => call());
+    tail = result.catch(() => {});
+    return result;
+  };
+}
+const runLine = line();
+const shellLine = line();
+
+// Keystrokes for the command running in the kirokit tab.
+export const runWrite = (id, data) => runLine(() => app().RunWrite(id, data));
+
+// Keystrokes and the dock size for the zsh tab.
+export const shellWrite = (data) => shellLine(() => app().ShellWrite(data));
+
+export const shellResize = (cols, rows) => app().ShellResize(cols, rows);
+
+// Subscribes to a Go event; returns the function that unsubscribes.
+export function on(event, handler) {
+  const rt = window.runtime;
+  return rt && rt.EventsOn ? rt.EventsOn(event, handler) : () => {};
+}
diff --git a/desktop/frontend/src/dialogs.js b/desktop/frontend/src/dialogs.js
new file mode 100644
index 0000000..2c6af6a
--- /dev/null
+++ b/desktop/frontend/src/dialogs.js
@@ -0,0 +1,89 @@
+// The two dialogs of Install: replacing the installed team, and the setup
+// check. The state builders are plain functions so node's test runner covers
+// them; createDialogs draws them in the <dialog> elements of index.html.
+import { esc } from './pages/html.js';
+
+// What the setup dialog shows for the checks Go reported.
+export function setupState(checks) {
+  const list = checks || [];
+  const failing = list.filter((c) => !c.found).length;
+  const canInstall = list.length > 0 && failing === 0;
+  let status = 'Checking...';
+  if (list.length) {
+    status = failing === 0
+      ? 'Everything is ready. You can install.'
+      : `${failing} of ${list.length} checks ${failing === 1 ? 'needs' : 'need'} attention. Fix them, then press Check again.`;
+  }
+  return { checks: list, failing, canInstall, status };
+}
+
+export function setupRows(checks) {
+  return (checks || [])
+    .map((c) => `<li data-found="${c.found}"><span class="badge ${c.found ? 'ok' : 'warn'}">${c.found ? 'found' : 'missing'}</span> <b>${esc(c.name)}</b><span class="detail">${esc(c.detail)}</span></li>`)
+    .join('\n');
+}
+
+// What pressing Install on a team leads to: nothing when it is already
+// installed, the replace dialog when another team is, else the setup check.
+export function installPlan(team, installs) {
+  const teams = (installs || []).map((r) => r.Team);
+  if (teams.includes(team)) return { kind: 'skip' };
+  return teams.length ? { kind: 'replace', installed: teams } : { kind: 'setup' };
+}
+
+export function replaceMessage(team, installed) {
+  return `${installed.join(' and ')} is installed. A Kiro home holds one team, so installing ${team} uninstalls ${installed.join(' and ')} first.`;
+}
+
+// createDialogs wires the dialog markup in index.html. Each question resolves
+// true when the person confirms, false on Cancel or Escape.
+export function createDialogs(doc = document) {
+  const ask = (dialog, ready) =>
+    new Promise((resolve) => {
+      dialog.returnValue = '';
+      dialog.addEventListener('close', () => resolve(dialog.returnValue === 'ok'), { once: true });
+      dialog.showModal();
+      ready?.();
+    });
+
+  const replace = doc.getElementById('replace-dialog');
+  const setup = doc.getElementById('setup-dialog');
+
+  return {
+    confirmReplace(team, installed) {
+      doc.getElementById('replace-text').textContent = replaceMessage(team, installed);
+      return ask(replace);
+    },
+
+    // loadChecks() resolves to the checks; Check again calls it afresh.
+    confirmSetup(team, loadChecks) {
+      doc.getElementById('setup-title').textContent = `Install ${team}`;
+      const rows = doc.getElementById('setup-checks');
+      const status = doc.getElementById('setup-status');
+      const install = doc.getElementById('setup-install');
+      const again = doc.getElementById('setup-again');
+
+      const show = (checks) => {
+        const s = setupState(checks);
+        rows.innerHTML = setupRows(s.checks);
+        status.textContent = s.status;
+        install.disabled = !s.canInstall;
+      };
+      const check = async () => {
+        again.disabled = true;
+        install.disabled = true;
+        status.textContent = 'Checking...';
+        try {
+          show(await loadChecks());
+        } catch (e) {
+          rows.innerHTML = '';
+          status.textContent = String((e && e.message) || e);
+        } finally {
+          again.disabled = false;
+        }
+      };
+      again.onclick = check;
+      return ask(setup, check);
+    },
+  };
+}
diff --git a/desktop/frontend/src/main.js b/desktop/frontend/src/main.js
new file mode 100644
index 0000000..aa92e61
--- /dev/null
+++ b/desktop/frontend/src/main.js
@@ -0,0 +1,175 @@
+import './style.css';
+import logoUrl from '../../../assets/logo.svg';
+import { createSidebar, PAGES } from './sidebar.js';
+import * as api from './api.js';
+import { initSettings, updateArgs } from './pages/settings.js';
+import { initTeams } from './pages/teams.js';
+import { initAgents } from './pages/agents.js';
+import { initInstall, syncArgs, uninstallArgs } from './pages/install.js';
+import { initSkills } from './pages/skills.js';
+import { initWelcome, showWelcome } from './pages/welcome.js';
+import { createDialogs, installPlan } from './dialogs.js';
+import { createDock } from './tabs.js';
+import { initDock } from './terminal.js';
+
+document.getElementById('logo').src = logoUrl;
+
+const app = document.getElementById('app');
+const collapse = document.getElementById('collapse');
+const navButtons = [...document.querySelectorAll('.nav button')];
+const sidebar = createSidebar();
+
+// The pages draw from one view: the catalog, the install records, whether the
+// clone exists, and the state of the buttons. A catalog error is kept as text
+// for the pages. Until the first State arrives (loaded) nothing is decided.
+const view = {
+  catalog: { teams: [], pins: {}, tag: '' },
+  installs: [],
+  error: '',
+  cloned: false,
+  loaded: false,
+  running: false, // a button command is running in the kirokit tab
+  actionError: null, // { where, message } of a refused command
+  notice: '', // the no-release message, or why the last clone failed
+  welcome: { address: '', error: '', busy: false },
+};
+const setup = () => view.loaded && showWelcome(view);
+
+function render({ collapsed, page }) {
+  const welcoming = setup();
+  app.classList.toggle('rail', collapsed);
+  app.classList.toggle('setup', welcoming);
+  document.getElementById('page-welcome').hidden = !welcoming;
+  collapse.setAttribute('aria-expanded', String(!collapsed));
+  collapse.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
+  collapse.querySelector('.label').textContent = collapsed ? 'Expand' : 'Collapse';
+  for (const p of PAGES) document.getElementById('page-' + p).hidden = welcoming || p !== page;
+  for (const b of navButtons) {
+    if (b.dataset.page === page) b.setAttribute('aria-current', 'page');
+    else b.removeAttribute('aria-current');
+  }
+}
+
+sidebar.subscribe((s) => {
+  render(s);
+  document.getElementById('main').scrollTop = 0;
+});
+collapse.addEventListener('click', () => sidebar.toggle());
+for (const b of navButtons) b.addEventListener('click', () => sidebar.select(b.dataset.page));
+document.addEventListener('keydown', (e) => sidebar.handleKey(e));
+render(sidebar);
+
+const dialogs = createDialogs();
+const message = (e) => String((e && e.message) || e);
+
+// Runs kirokit with args in the kirokit tab. A refusal, such as "kirokit is
+// still running a command", shows beside the button at where.
+let lastExit = 0;
+async function runCommand(args, where) {
+  view.actionError = null;
+  try {
+    const id = await api.run(args);
+    // A fast command may already have ended before the id arrives.
+    if (id > lastExit) view.running = true;
+  } catch (e) {
+    view.actionError = { where, message: message(e) };
+  }
+  draw();
+}
+
+async function installTeam(team) {
+  const plan = installPlan(team, view.installs);
+  if (plan.kind === 'skip') {
+    view.actionError = { where: 'install:' + team, message: `${team} is already installed.` };
+    draw();
+    return;
+  }
+  if (plan.kind === 'replace' && !(await dialogs.confirmReplace(team, plan.installed))) return;
+  if (!(await dialogs.confirmSetup(team, () => api.prerequisites(team)))) return;
+  await runCommand(['install', team], 'install:' + team);
+}
+
+async function startClone(address) {
+  view.welcome = { address: address.trim(), error: '', busy: true };
+  draw();
+  try {
+    await api.clone(address);
+  } catch (e) {
+    view.welcome = { address: address.trim(), error: message(e), busy: false };
+    draw();
+  }
+}
+
+const settings = initSettings(() => runCommand(updateArgs(view.installs), 'update'));
+const paint = [
+  initWelcome(document.getElementById('page-welcome'), startClone),
+  initTeams(document.getElementById('teams-grid'), installTeam),
+  initAgents(document.getElementById('page-agents')),
+  initInstall(document.getElementById('page-install'), (action, team) =>
+    runCommand(action === 'sync' ? syncArgs(team) : uninstallArgs(team), action + ':' + team)),
+  initSkills(document.getElementById('page-skills')),
+  settings.paint,
+];
+
+function draw() {
+  for (const p of paint) p(view);
+  const notice = document.getElementById('notice');
+  notice.textContent = view.notice;
+  notice.hidden = !view.notice;
+  render(sidebar);
+  for (const [name, n] of [['teams', view.catalog.teams.length], ['agents', view.catalog.teams.reduce((sum, t) => sum + t.agents.length, 0)]]) {
+    document.querySelector(`[data-count="${name}"]`).textContent = n || '';
+  }
+}
+
+async function loadCatalog() {
+  try {
+    const st = await api.state();
+    view.cloned = st.cloned;
+    view.loaded = true;
+    // The address field starts from the saved one; typing replaces it.
+    if (!view.welcome.address) view.welcome = { ...view.welcome, address: st.settings.repoUrl || '' };
+    view.catalog = await api.catalog();
+    view.error = '';
+  } catch (e) {
+    view.error = message(e);
+  }
+  draw();
+}
+
+async function loadInstalls() {
+  try {
+    view.installs = (await api.installs()) || [];
+  } catch (e) {
+    view.error = view.error || message(e);
+  }
+  draw();
+}
+
+const refresh = () => loadCatalog().then(loadInstalls);
+
+initDock(createDock());
+settings.load();
+refresh();
+api.on('installs:changed', (records) => {
+  view.installs = records || [];
+  draw();
+});
+api.on('term:kirokit', ({ id }) => {
+  if (id > lastExit && !view.running) {
+    view.running = true;
+    draw();
+  }
+});
+// A command that ends may have synced a new team or pin or installed one.
+api.on('term:kirokit:exit', ({ id }) => {
+  lastExit = Math.max(lastExit, id);
+  view.running = false;
+  refresh();
+});
+api.on('clone:done', ({ ok, error }) => {
+  view.welcome = { ...view.welcome, busy: false, error: ok ? '' : error };
+  view.notice = error || '';
+  settings.load(); // the Settings address field now shows the cloned address
+  refresh();
+});
