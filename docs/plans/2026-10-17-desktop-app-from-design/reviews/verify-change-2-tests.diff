--- /dev/null
+++ b/desktop/frontend/src/sidebar.test.js
@@ -0,0 +1,55 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createSidebar, PAGES } from './sidebar.js';
+
+const key = (init) => ({ key: 'b', metaKey: false, ctrlKey: false, preventDefault() { this.prevented = true; }, ...init });
+
+test('toggle collapses to the rail and expands again', () => {
+  const sb = createSidebar();
+  assert.equal(sb.collapsed, false);
+  sb.toggle();
+  assert.equal(sb.collapsed, true);
+  sb.toggle();
+  assert.equal(sb.collapsed, false);
+});
+
+test('Command-B toggles and is consumed', () => {
+  const sb = createSidebar();
+  const e = key({ metaKey: true });
+  assert.equal(sb.handleKey(e), true);
+  assert.equal(e.prevented, true);
+  assert.equal(sb.collapsed, true);
+  sb.handleKey(key({ metaKey: true, key: 'B' }));
+  assert.equal(sb.collapsed, false);
+});
+
+test('plain B and Control-B do nothing', () => {
+  const sb = createSidebar();
+  for (const init of [{}, { ctrlKey: true }]) {
+    const e = key(init);
+    assert.equal(sb.handleKey(e), false);
+    assert.equal(e.prevented, undefined);
+  }
+  assert.equal(sb.collapsed, false);
+});
+
+test('select switches among the five pages and ignores unknown ones', () => {
+  const sb = createSidebar();
+  assert.deepEqual(PAGES, ['teams', 'agents', 'install', 'skills', 'settings']);
+  assert.equal(sb.page, 'teams');
+  for (const p of PAGES) {
+    sb.select(p);
+    assert.equal(sb.page, p);
+  }
+  sb.select('nope');
+  assert.equal(sb.page, 'settings');
+});
+
+test('subscribers hear every change', () => {
+  const sb = createSidebar();
+  const seen = [];
+  sb.subscribe((s) => seen.push([s.collapsed, s.page]));
+  sb.toggle();
+  sb.select('agents');
+  assert.deepEqual(seen, [[true, 'teams'], [true, 'agents']]);
+});
diff --git a/desktop/frontend/src/tabs.test.js b/desktop/frontend/src/tabs.test.js
new file mode 100644
index 0000000..cd9d8c6
--- /dev/null
+++ b/desktop/frontend/src/tabs.test.js
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createDock, MIN_HEIGHT, MAX_HEIGHT, TABS } from './tabs.js';
+
+test('the dock starts closed on the kirokit tab', () => {
+  const dock = createDock();
+  assert.equal(dock.open, false);
+  assert.equal(dock.tab, 'kirokit');
+  assert.deepEqual(TABS, ['kirokit', 'shell']);
+});
+
+test('open, close and toggle change only the visibility', () => {
+  const dock = createDock();
+  dock.show();
+  assert.equal(dock.open, true);
+  dock.hide();
+  assert.equal(dock.open, false);
+  dock.toggle();
+  assert.equal(dock.open, true);
+  dock.toggle();
+  assert.equal(dock.open, false);
+});
+
+test('height stays within the minimum and maximum', () => {
+  const dock = createDock();
+  dock.resize(10);
+  assert.equal(dock.height, MIN_HEIGHT);
+  dock.resize(5000);
+  assert.equal(dock.height, MAX_HEIGHT);
+  dock.resize(300.4);
+  assert.equal(dock.height, 300);
+  dock.resize(Number.NaN);
+  assert.equal(dock.height, 300);
+});
+
+test('closing and reopening keeps the height and the tab', () => {
+  const dock = createDock();
+  dock.show();
+  dock.select('shell');
+  dock.resize(333);
+  dock.hide();
+  dock.show();
+  assert.equal(dock.tab, 'shell');
+  assert.equal(dock.height, 333);
+});
+
+test('an unknown tab is ignored', () => {
+  const dock = createDock();
+  dock.select('nope');
+  assert.equal(dock.tab, 'kirokit');
+});
+
+test('selecting a tab shows the dock and listeners see every change', () => {
+  const dock = createDock();
+  const seen = [];
+  const off = dock.subscribe((s) => seen.push({ ...s }));
+  dock.select('shell');
+  assert.deepEqual(seen.at(-1), { open: true, tab: 'shell', height: dock.height });
+  off();
+  dock.resize(200);
+  assert.equal(seen.length, 1);
+});
