# Wails v3 builds into bin/; scripts/desktop-build.sh stages it in build/bin.
/bin
# go-task's checksums for the v3 task files
/.task
build/bin
build/dev-bin
# Written again by every Windows package (`wails3 generate webview2bootstrapper`);
# project.nsi and wails_tools.nsh are ours and stay tracked.
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# The Windows build embeds this and removes it afterwards.
/*.syso
node_modules
# main.go embeds frontend/dist; the placeholder keeps a clean checkout compiling
frontend/dist/*
!frontend/dist/.gitkeep
