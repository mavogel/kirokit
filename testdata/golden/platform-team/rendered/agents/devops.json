{
  "name": "devops",
  "description": "Triages and resolves Jira tickets for platform-team, following the team's shared security baseline steering.",
  "prompt": "file://../prompts/jira-triage.md",
  "tools": ["read", "write", "glob", "knowledge", "shell", "@atlassian", "@context7"],
  "permissions": {
    "rules": [
      { "capability": "fs_read", "match": ["**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["/tmp/**"], "effect": "allow" },
      { "capability": "mcp", "match": ["@atlassian/*"], "effect": "ask" },
      { "capability": "mcp", "match": ["@context7/*"], "effect": "allow" },
      { "capability": "shell", "match": ["rm *"], "effect": "deny" },
      { "capability": "shell", "match": ["git push --force*", "git push -f*", "git push * --force*", "git push * -f*"], "effect": "deny" },
      { "capability": "shell", "match": ["git push * main", "git push * main *"], "effect": "deny" },
      { "capability": "shell", "match": ["git branch -d *", "git branch -D *", "git branch --delete*"], "effect": "deny" }
    ]
  },
  "resources": [
    "skill:///kiro-home/skills/jira-search/SKILL.md"
  ],
  "mcpServers": {
    "atlassian": {
      "command": "sops",
      "args": ["exec-env","/kiro-home/kirokit-secrets/platform-team/devops/secrets.enc.yaml","npx -y mcp-remote@0.14.3 https://mcp.atlassian.com/v2/mcp --header 'Authorization: ${ATLASSIAN_AUTH}'"],
      "timeout": 60000
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"],
      "timeout": 60000
    }
  }
}
