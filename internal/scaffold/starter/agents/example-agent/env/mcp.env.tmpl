# Placeholder for this agent's MCP server env/secrets.
#
# Files under agents/<agent>/env/ are never written to the rendered output
# tree directly - the render engine skips this directory entirely (see
# internal/render's path mapping). They exist only to be referenced by
# agent.json.tmpl.
#
# If example-agent's MCP server needs a secret, replace this file with a
# SOPS-encrypted secrets.enc.yaml (see README: Secrets via SOPS) and
# reference its path from agent.json.tmpl's mcpServers entry via the
# sopsCommand / sopsArgsJSON template funcs, e.g.:
#
#   "command": {{ sopsCommand }},
#   "args": {{ sopsArgsJSON "agents/example-agent/env/secrets.enc.yaml" "real-mcp-server" "--flag" }}
